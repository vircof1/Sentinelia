# Contrato de configuración para una instalación Docker de Sentinelia.
# El bootstrap de una base nueva debe materializar las credenciales y claves
# criptográficas marcadas como REEMPLAZAR_* antes de exponer la instancia.

# Entorno de ejecución de Node.js; production activa el comportamiento productivo.
NODE_ENV=production
# Puerto HTTP dentro del contenedor de aplicación, en TCP.
PUERTO_WEB=3000

# Identificador estable del proceso runtime; vacío deriva hostname y PID.
RUNTIME_INSTANCIA_ID=
# Tiempo máximo concedido al apagado ordenado del runtime, en milisegundos.
RUNTIME_APAGADO_TIMEOUT_MS=10000
# Periodo base del scheduler de monitores, en milisegundos.
RUNTIME_SCHEDULER_TICK_MS=1000
# Espacio de nombres Redis utilizado por presencia y coordinación del runtime.
RUNTIME_REDIS_PREFIJO=sentinelia:runtime:
# Frecuencia con la que el runtime publica su latido, en milisegundos.
RUNTIME_LATIDO_INTERVALO_MS=5000
# Vigencia de una presencia runtime sin renovar, en segundos.
RUNTIME_PRESENCIA_TTL_SEGUNDOS=15
# Máximo de trabajos de evaluación de telemetría reclamados por lote.
RUNTIME_TELEMETRIA_EVALUACION_LOTE_MAXIMO=25
# Máximo de perfiles de servidor procesados en un lote del runtime.
RUNTIME_PERFIL_SERVIDOR_LOTE_MAXIMO=50
# Vigencia del reclamo de una evaluación de telemetría, en segundos.
RUNTIME_TELEMETRIA_EVALUACION_RECLAMO_TTL_SEGUNDOS=30
# Espera inicial para reintentar una evaluación fallida, en segundos.
RUNTIME_TELEMETRIA_EVALUACION_REINTENTO_BASE_SEGUNDOS=5
# Tope de la espera incremental entre reintentos de evaluación, en segundos.
RUNTIME_TELEMETRIA_EVALUACION_REINTENTO_MAXIMO_SEGUNDOS=300
# Máximo de obligaciones temporales examinadas por lote de reloj.
RUNTIME_TELEMETRIA_RELOJ_LOTE_MAXIMO=100
# Máximo de lotes temporales procesados en un único ciclo del runtime.
RUNTIME_TELEMETRIA_RELOJ_MAXIMO_LOTES_POR_CICLO=4
# Retraso tolerado antes de avisar por una obligación temporal vencida, en segundos.
RUNTIME_TELEMETRIA_RELATIVA_RETRASO_AVISO_SEGUNDOS=60
# Número máximo de eventos de auditoría despachados simultáneamente.
RUNTIME_AUDITORIA_OUTBOX_CONCURRENCIA=8
# Vigencia del lease de un evento de auditoría reclamado, en segundos.
RUNTIME_AUDITORIA_OUTBOX_LEASE_TTL_SEGUNDOS=30
# Espera inicial de reintento del outbox de auditoría, en segundos.
RUNTIME_AUDITORIA_OUTBOX_REINTENTO_BASE_SEGUNDOS=5
# Tope de espera entre reintentos del outbox de auditoría, en segundos.
RUNTIME_AUDITORIA_OUTBOX_REINTENTO_MAXIMO_SEGUNDOS=3600

# Host SQL visto desde la red Docker.
SQL_HOST=mariadb
# Puerto TCP del servidor SQL.
SQL_PUERTO=3306
# Usuario con permisos sobre la base de Sentinelia.
SQL_USUARIO=root
# Credencial SQL que el bootstrap debe generar para una instalación nueva.
SQL_PASSWORD=REEMPLAZAR_POR_PASSWORD_SQL_PROPIO
# Nombre de la base de datos de Sentinelia.
SQL_BASE_DATOS=Sentinelia_Node
# Permite aplicar automáticamente migraciones pendientes durante el arranque.
SQL_BOOTSTRAP_MIGRACIONES=true
# Ruta alternativa de migraciones; vacío utiliza migraciones/sql.
RUTA_MIGRACIONES=

# URL de conexión a Redis desde los contenedores de aplicación.
REDIS_URL=redis://redis:6379
# Espacio de nombres de las sesiones web efímeras.
REDIS_PREFIJO_SESIONES=sentinelia:sesion:
# Espacio de nombres de preautenticaciones web de un solo uso.
REDIS_PREFIJO_PREAUTENTICACIONES=sentinelia:preautenticacion:
# Espacio de nombres de las proyecciones de sesiones web durables.
REDIS_PREFIJO_SESIONES_WEB_DURABLES=sentinelia:sesiones:web:
# Canal Redis que difunde invalidaciones de sesiones web.
REDIS_CANAL_INVALIDACIONES_SESIONES_WEB=sentinelia:sesiones:web:invalidaciones
# Espacio de nombres de sesiones técnicas de agentes.
REDIS_PREFIJO_SESIONES_AGENTES=sentinelia:agentes:sesiones:
# Espacio de nombres de la versión vigente de cada usuario.
REDIS_PREFIJO_VERSION_USUARIO=sentinelia:usuario:
# Clave Redis que anuncia cambios de configuración del portal.
REDIS_CLAVE_VERSION_CONFIGURACION_PORTAL=sentinelia:configuracion_portal:version
# Clave Redis que anuncia cambios de monitores al runtime.
REDIS_CLAVE_VERSION_RUNTIME_MONITORES=sentinelia:runtime:monitores:version
# Clave Redis que versiona el catálogo de monitores.
REDIS_CLAVE_VERSION_CATALOGO_MONITORES=sentinelia:catalogo:monitores:version
# Clave Redis que anuncia cambios del catálogo DNS.
REDIS_CLAVE_VERSION_DNS=sentinelia:catalogo:dns:version
# Espacio de nombres de decisiones de autorización del perfil propio.
REDIS_PREFIJO_AUTORIZACION_PERFIL=sentinelia:perfil:autorizacion:
# Espacio de nombres de operaciones de correo del perfil propio.
REDIS_PREFIJO_OPERACIONES_EMAIL_PERFIL=sentinelia:perfil:email:
# Espacio de nombres de bloqueos coordinados del correo.
REDIS_PREFIJO_BLOQUEO_CORREO=sentinelia:correo:bloqueo:
# Espacio de nombres de verificaciones operativas del correo.
REDIS_PREFIJO_VERIFICACION_CORREO_OPERATIVO=sentinelia:correo:verificacion_operativa:
# Espacio de nombres de coordinación de la federación.
REDIS_PREFIJO_FEDERACION=sentinelia:federacion
# Vigencia de la coordinación de un arranque federado, en segundos.
REDIS_TTL_ARRANQUE_FEDERACION_SEGUNDOS=120

# Nombre de la cookie de sesión enviada al navegador.
SESION_COOKIE_NOMBRE=sentinelia.sid
# Secreto raíz de sesiones, cursores y confirmaciones; lo provisiona el bootstrap.
SESION_SECRETO=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
# Duración máxima de una sesión web, en milisegundos.
SESION_MAX_AGE_MS=28800000

# Keyring de 256 bits para cifrar replay de sesiones técnicas de agentes.
AGENTES_SESION_KEYRING={"bootstrap-1":"REEMPLAZAR_POR_BASE64_CANONICO_DE_32_BYTES"}
# Identificador de la clave activa dentro del keyring de agentes.
AGENTES_SESION_KEY_ID_ACTIVA=bootstrap-1
# Activa la ingesta y evaluación del perfil técnico de servidor.
AGENTES_PERFIL_SERVIDOR_HABILITADO=true
# Publica la API de eliminación administrativa cuando sus gates están satisfechos.
AGENTES_ELIMINACION_ADMINISTRATIVA_HTTP_HABILITADA=true
# Tiempo máximo para alcanzar compatibilidad del despliegue de eliminación, en ms.
AGENTES_ELIMINACION_ADMINISTRATIVA_ESPERA_COMPATIBILIDAD_MS=60000
# Activa la capacidad DDNS de agentes cuando sus precondiciones están satisfechas.
AGENTES_DDNS_HABILITADO=true
# Vigencia de una sesión técnica de agente, en segundos.
AGENTES_SESSION_TTL_SEGUNDOS=900
# Intervalo de heartbeat recomendado a los agentes, en segundos.
AGENTES_HEARTBEAT_INTERVAL_SEGUNDOS=30
# Margen adicional antes de considerar ausente un agente, en segundos.
AGENTES_HEARTBEAT_GRACE_SEGUNDOS=90
# Fallos de login consecutivos admitidos antes de imponer cuarentena.
AGENTES_LOGIN_FALLOS_MAXIMOS=5
# Duración de la cuarentena tras exceder los fallos de login, en segundos.
AGENTES_CUARENTENA_SEGUNDOS=900

# Usuario del primer administrador creado únicamente en una base nueva.
USUARIO_ADMIN_INICIAL=admin
# Password inicial del administrador; el bootstrap debe exigir un valor propio.
PASSWORD_ADMIN_INICIAL=REEMPLAZAR_POR_PASSWORD_ADMIN_PROPIO
# Correo inicial del administrador; puede modificarse después desde el portal.
EMAIL_ADMIN_INICIAL=admin@example.invalid
# Nombre mostrado para el primer administrador.
NOMBRE_ADMIN_INICIAL=Administrador
# Nombre de producto mostrado por defecto en la interfaz.
PORTAL_NOMBRE_VISIBLE=Sentinelia
# Origen público HTTPS canónico; vacío mientras no exista publicación externa.
PORTAL_ORIGEN_PUBLICO=
# Lista separada por comas de proxies inversos cuya cabecera se considera fiable.
PORTAL_PROXIES_REVERSOS_CONFIABLES=

# Dirección del host donde Docker publica HTTP; loopback evita exposición directa.
WEB_BIND_ADDRESS=127.0.0.1
# Puerto TCP del host que publica el portal web.
WEB_PUERTO_PUBLICADO=3001

# Activa funciones federadas; false mantiene cerradas sus superficies públicas.
FEDERACION_ACTIVA=false
# Desviación temporal máxima admitida entre instancias, en milisegundos.
FEDERACION_TOLERANCIA_TEMPORAL_MS=5000
# Número máximo de ocurrencias federadas aceptadas en un lote.
FEDERACION_LOTE_MAXIMO_OCURRENCIAS=200
# Tamaño máximo de un lote federado completo, en bytes.
FEDERACION_LOTE_MAXIMO_BYTES=1048576
# Tamaño máximo de una ocurrencia federada individual, en bytes.
FEDERACION_OCURRENCIA_MAXIMA_BYTES=262144
# Capacidad anunciada por la instancia receptora, en ocurrencias.
FEDERACION_CAPACIDAD_RECEPTORA_OCURRENCIAS=1000
# Vigencia del estado operativo remoto, en milisegundos.
FEDERACION_TTL_ESTADO_OPERATIVO_MS=300000
# Silencio máximo antes de considerar inactiva una relación, en milisegundos.
FEDERACION_SILENCIO_RELACION_MS=120000
# Ventana de consolidación después de reiniciar federación, en milisegundos.
FEDERACION_CONSOLIDACION_REINICIO_MS=60000
# Retención máxima de información federada, en días.
FEDERACION_RETENCION_MAXIMA_DIAS=90
# Referencia estable que identifica la custodia externa del keyring federado.
FEDERACION_KEYRING_REFERENCIA=sentinelia/federacion/v1
# Keyring de 256 bits para proteger secretos persistentes de federación.
FEDERACION_KEYRING={"bootstrap-1":"REEMPLAZAR_POR_BASE64_CANONICO_DE_32_BYTES"}
# Identificador de la clave activa dentro del keyring federado.
FEDERACION_KEY_ID_ACTIVA=bootstrap-1

# Estado funcional inicial de DNS; BIND arranca aunque esta capacidad sea false.
DNS_ACTIVO=false
# Dirección del host donde Docker publica DNS.
DNS_BIND_ADDRESS=127.0.0.1
# Puerto TCP y UDP del host que publica el puerto 53 del contenedor.
DNS_PUERTO_PUBLICADO=8053
# Directorio persistente donde Sentinelia construye artefactos BIND.
BIND_RAIZ_ARTEFACTOS=/var/lib/sentinelia/bind/artefactos
# Include persistente que selecciona la generación DNS activa.
BIND_SELECTOR_ACTIVO=/etc/bind/sentinelia-selector.conf
# Archivo utilizado para excluir publicaciones DNS concurrentes.
BIND_LOCK_FILE=/var/lib/sentinelia/bind/publicacion.lock
# Configuración raíz validada y cargada por named.
BIND_NAMED_CONF_ACTIVO=/etc/bind/sentinelia-root.conf
# Ejecutable de named dentro del contenedor.
BIND_NAMED_EXECUTABLE=/usr/sbin/named
# Argumentos JSON adicionales entregados directamente a named.
BIND_NAMED_ARGUMENTOS_JSON=[]
# Ejecutable de control RNDC dentro del contenedor.
BIND_RNDC_EXECUTABLE=/usr/sbin/rndc
# Argumentos JSON de RNDC; usan el canal local autenticado de Sentinelia.
BIND_RNDC_ARGUMENTOS_JSON=["-s","127.0.0.1","-p","953","-k","/run/named/sentinelia-rndc.key"]
# Ejecutable utilizado para validar la configuración global de BIND.
BIND_CHECKCONF_EXECUTABLE=/usr/bin/named-checkconf
# Ejecutable utilizado para validar el contenido de cada zona DNS.
BIND_CHECKZONE_EXECUTABLE=/usr/bin/named-checkzone
# Direcciones IPv4 donde named escucha dentro del contenedor.
DNS_LISTEN_ON=127.0.0.1
# Direcciones IPv6 donde named escucha dentro del contenedor.
DNS_LISTEN_ON_V6=::1
# ACL de clientes autorizados a consultar el servidor DNS.
DNS_ALLOW_QUERY=any
# Permite o deniega resolución recursiva desde BIND.
DNS_RECURSION=false
# Habilita el uso de servidores forwarders configurados explícitamente.
DNS_FORWARDERS_HABILITADOS=false
# Lista de direcciones de forwarders; vacía cuando están deshabilitados.
DNS_FORWARDERS=

# Variación porcentual cerca del fallo que fuerza un punto histórico adicional.
MONITORES_COMPACTACION_CERCA_FALLO_PORCENTAJE=10
# Variación porcentual de una serie que impide compactar el nuevo estado.
MONITORES_COMPACTACION_SERIE_VARIACION_PORCENTAJE=10
# Retención de eventos detallados de monitor, en días.
MONITORES_RETENCION_EVENTOS_DIAS=45
# Vigencia del bloqueo distribuido de ejecución de un monitor, en segundos.
MONITORES_RUNTIME_BLOQUEO_TTL_SEGUNDOS=30

# Tiempo máximo para alcanzar compatibilidad de eliminación organizativa, en ms.
ORGANIZACION_ELIMINACION_ADMINISTRATIVA_ESPERA_COMPATIBILIDAD_MS=60000

# Activa el subsistema de correo; false impide emisiones externas.
CORREO_ACTIVO=false
# Keyring de 256 bits que protege credenciales y material técnico de correo.
CORREO_KEYRING={"bootstrap-1":"REEMPLAZAR_POR_BASE64_CANONICO_DE_32_BYTES"}
# Identificador de la clave activa dentro del keyring de correo.
CORREO_KEY_ID_ACTIVA=bootstrap-1
# Host del servidor SMTP; vacío mientras el correo esté desactivado.
CORREO_SMTP_HOST=
# Puerto TCP del servidor SMTP.
CORREO_SMTP_PUERTO=587
# Usa TLS implícito desde el inicio de la conexión SMTP.
CORREO_SMTP_SECURE=false
# Usuario de autenticación SMTP; vacío si el servidor no lo exige.
CORREO_SMTP_USUARIO=
# Password del servidor SMTP externo; vacío mientras no exista integración.
CORREO_SMTP_PASSWORD=
# Método AUTH solicitado a Nodemailer; vacío permite negociación automática.
CORREO_SMTP_AUTH_METHOD=
# Tiempo máximo para establecer la conexión SMTP, en milisegundos.
CORREO_SMTP_TIMEOUT_CONEXION_MS=10000
# Tiempo máximo para recibir el saludo SMTP, en milisegundos.
CORREO_SMTP_TIMEOUT_SALUDO_MS=10000
# Tiempo máximo de inactividad del socket SMTP, en milisegundos.
CORREO_SMTP_TIMEOUT_SOCKET_MS=30000
# Permite certificados SMTP no confiables; debe permanecer false normalmente.
CORREO_SMTP_TLS_PERMITIR_INSEGURO=false
# Dirección From utilizada por el correo; vacía mientras esté desactivado.
CORREO_REMITENTE_EMAIL=
# Nombre legible que acompaña a la dirección remitente.
CORREO_REMITENTE_NOMBRE=Sentinelia
# Número máximo de intentos antes de terminalizar una salida de correo.
CORREO_MAX_REINTENTOS=3
# Espera inicial entre reintentos SMTP, en segundos.
CORREO_REINTENTO_BASE_SEGUNDOS=60
# Vigencia del bloqueo distribuido del despachador, en segundos.
CORREO_BLOQUEO_TTL_SEGUNDOS=90
# Máximo de correos reclamados por un ciclo del runtime.
CORREO_RUNTIME_LOTE_MAXIMO=3

# Activa la prueba de trabajo adaptativa en las superficies públicas.
POW_ACTIVO=true
# Espacio de nombres Redis para retos y estado de PoW.
POW_REDIS_PREFIJO=sentinelia:pow:
# Vigencia de un reto PoW no consumido, en segundos.
POW_TTL_DESAFIO_SEGUNDOS=300
# Tiempo de resolución objetivo utilizado para ajustar el coste, en ms.
POW_TIEMPO_OBJETIVO_MS=1500
# Límite inferior aceptado para una resolución normal, en milisegundos.
POW_TIEMPO_MINIMO_MS=750
# Límite superior aceptado para una resolución normal, en milisegundos.
POW_TIEMPO_MAXIMO_MS=8000
# Ventana temporal que acumula intentos y fallos, en segundos.
POW_VENTANA_INTENTOS_SEGUNDOS=900
# Penalización añadida por cada intento dentro de la ventana, en ms.
POW_INCREMENTO_POR_INTENTO_MS=250
# Penalización añadida por cada fallo dentro de la ventana, en ms.
POW_INCREMENTO_POR_FALLO_MS=700
# Coste mínimo permitido por el algoritmo adaptativo.
POW_COSTE_MINIMO=16
# Coste máximo permitido por el algoritmo adaptativo.
POW_COSTE_MAXIMO=24
# Rendimiento asumido cuando el cliente no aporta benchmark, en hashes/s.
POW_HASHRATE_POR_DEFECTO=60000
# Rendimiento mínimo aceptado para normalizar el benchmark, en hashes/s.
POW_HASHRATE_MINIMO=25000
# Rendimiento máximo aceptado para normalizar el benchmark, en hashes/s.
POW_HASHRATE_MAXIMO=1500000
# Duración objetivo del benchmark ejecutado en el cliente, en milisegundos.
POW_BENCHMARK_CLIENTE_MS=180
