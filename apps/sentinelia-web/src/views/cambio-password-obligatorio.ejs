<%- include('parciales/cabecera', { titulo, usuarioActual: null }) %>

<section class="panel-acceso panel-acceso--cambio-password">
  <div class="acceso-layout acceso-layout--cambio-password">
    <div class="caja-acceso caja-acceso--cambio-password">
      <div class="cambio-password__cabecera">
        <div class="cambio-password__titulo">
          <h1>Crea una contraseña nueva</h1>
          <p>Debes cambiarla antes de continuar.</p>
        </div>
        <div class="cambio-password__identidad" aria-label="Cuenta que continuará la sesión">
          <span class="cambio-password__identidad-icono" aria-hidden="true">
            <i class="bi bi-person"></i>
          </span>
          <span>
            <small>Usuario</small>
            <strong><%= formulario.usuario %></strong>
          </span>
        </div>
      </div>

      <% if (error) { %>
        <div class="mensaje-error mensaje-error--suave" role="alert"><%= error %></div>
      <% } %>

      <form
        method="post"
        action="/cambio-password-obligatorio"
        class="formulario-acceso formulario-acceso--cambio-password"
        data-cambio-password
      >
        <input type="hidden" name="_csrf" value="<%= tokenCSRFPortal %>">
        <div class="campo-password">
          <label for="password_nuevo">Nueva contraseña</label>
          <div class="campo-password__control">
            <input
              id="password_nuevo"
              name="password_nuevo"
              type="password"
              autocomplete="new-password"
              required
              minlength="8"
              data-cambio-password-nueva
            >
            <button
              type="button"
              class="campo-password__toggle"
              data-password-toggle="password_nuevo"
              aria-controls="password_nuevo"
              aria-label="Mostrar nueva contraseña"
            >
              <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="campo-password">
          <label for="password_confirmacion">Confirmar contraseña</label>
          <div class="campo-password__control">
            <input
              id="password_confirmacion"
              name="password_confirmacion"
              type="password"
              autocomplete="new-password"
              required
              minlength="8"
              data-cambio-password-confirmacion
            >
            <button
              type="button"
              class="campo-password__toggle"
              data-password-toggle="password_confirmacion"
              aria-controls="password_confirmacion"
              aria-label="Mostrar confirmación de contraseña"
            >
              <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div class="cambio-password__checklist" aria-live="polite">
          <div class="cambio-password__regla" data-cambio-password-regla="longitud">
            <span aria-hidden="true">•</span>
            Mínimo 8 caracteres.
          </div>
          <div class="cambio-password__regla" data-cambio-password-regla="coincidencia">
            <span aria-hidden="true">•</span>
            Ambas contraseñas coinciden.
          </div>
          <div class="cambio-password__regla cambio-password__regla--informativa">
            <span aria-hidden="true"><i class="bi bi-shield-check"></i></span>
            Debe ser distinta de la contraseña provisional o anterior.
          </div>
        </div>

        <button
          type="submit"
          class="boton-primario boton-primario--cambio-password"
          data-cambio-password-submit
          disabled
        >
          Guardar y continuar
        </button>
      </form>
    </div>
  </div>
</section>

<%- include('parciales/pie') %>
