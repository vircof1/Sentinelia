<%
const condicionActual = revision?.condicion || null;
const configuracionActual = condicionActual?.configuracion || {};
const mostrarRelativo = condicionActual?.tipo === 'momento_utc_relativo' ||
  (typeof mostrarMomentoUtcRelativo !== 'undefined' && mostrarMomentoUtcRelativo);
const limiteRelativo = configuracionActual.limite ||
  { direccion: 'pasado', segundos: '3600' };
const limiteInferiorRelativo = configuracionActual.limiteInferior ||
  { direccion: 'pasado', segundos: '86400' };
const limiteSuperiorRelativo = configuracionActual.limiteSuperior ||
  { direccion: 'futuro', segundos: '3600' };
%>
<div class="col-12 col-lg-6"><label class="form-label">Nombre para los operadores</label><input class="form-control" name="nombre" maxlength="160" value="<%= revision?.nombre || '' %>" required></div>
<div class="col-12"><label class="form-label">Qué significa esta regla</label><textarea class="form-control" name="descripcion" maxlength="512" rows="2"><%= revision?.descripcion || '' %></textarea></div>
<div class="col-12 col-md-4"><label class="form-label">Dato que se comprobará</label><select class="form-select" name="condicion_tipo" data-regla-tipo required><% for (const opcion of [['numero', 'Valor numérico'], ['duracion', 'Duración'], ...(mostrarRelativo ? [['momento_utc_relativo', 'Fecha respecto a ahora']] : []), ['momento_utc', 'Fecha fija'], ['booleano', 'Verdadero o falso'], ['estado', 'Estado'], ['texto', 'Texto exacto'], ['texto_regex', 'Texto por patrón seguro'], ['calidad', 'Calidad de la lectura']]) { %><option value="<%= opcion[0] %>" <%= condicionActual?.tipo === opcion[0] ? 'selected' : '' %>><%= opcion[1] %></option><% } %></select></div>
<div class="col-12 col-md-4" data-campo-operador><label class="form-label">Comparación</label><select class="form-select" name="operador" data-regla-operador required><% for (const operador of ['>', '>=', '<', '<=', '=', '!=']) { %><option value="<%= operador %>" <%= configuracionActual.operador === operador ? 'selected' : '' %>><%= operador %></option><% } %></select></div>
<div class="col-12 col-md-4" data-campo-numero><label class="form-label">Valor límite <span class="text-body-secondary" data-regla-unidad></span></label><input class="form-control" type="number" step="any" name="umbral" value="<%= configuracionActual.umbral ?? '' %>" data-regla-umbral><div class="form-text" data-regla-duracion-ayuda hidden></div></div>
<div class="col-12 col-md-4" data-campo-momento hidden><label class="form-label">Momento límite <span class="text-body-secondary">(hora local)</span></label><input class="form-control" type="datetime-local" step="1" data-regla-momento-local><input type="hidden" name="umbral_utc" value="<%= configuracionActual.umbralUtc ?? '' %>" data-regla-momento-utc><div class="form-text" data-regla-momento-ayuda>Se enviará como UTC canónico con precisión de segundo.</div></div>
<fieldset class="col-12" data-campo-momento-relativo hidden>
  <legend class="h6">Comparación respecto al presente</legend>
  <p class="text-body-secondary small">La fecha informada por el agente se comparará continuamente con el reloj UTC de Sentinelia.</p>
  <div class="row g-3">
    <div class="col-12 col-lg-4"><label class="form-label">Cuándo requiere atención</label><select class="form-select" name="relativo_forma" data-relativo-forma><% for (const forma of [['limite_inferior', 'Si queda por debajo del límite'], ['limite_superior', 'Si supera el límite'], ['fuera_intervalo', 'Si queda fuera de un intervalo']]) { %><option value="<%= forma[0] %>" <%= (configuracionActual.forma || 'limite_inferior') === forma[0] ? 'selected' : '' %>><%= forma[1] %></option><% } %></select></div>
    <div class="col-12 col-lg-8" data-relativo-limite>
      <div class="row g-2"><div class="col-12"><span class="form-label d-block">Límite</span></div><div class="col-5"><select class="form-select" name="relativo_limite_direccion" data-relativo-direccion><% for (const direccion of [['pasado', 'En el pasado'], ['ahora', 'Ahora'], ['futuro', 'En el futuro']]) { %><option value="<%= direccion[0] %>" <%= limiteRelativo.direccion === direccion[0] ? 'selected' : '' %>><%= direccion[1] %></option><% } %></select></div><div class="col-3"><input class="form-control" name="relativo_limite_magnitud" inputmode="numeric" pattern="[0-9]+" value="<%= limiteRelativo.segundos %>" aria-label="Magnitud del límite" data-relativo-magnitud></div><div class="col-4"><select class="form-select" name="relativo_limite_unidad" aria-label="Unidad del límite" data-relativo-unidad><option value="segundos">segundos</option><option value="minutos">minutos</option><option value="horas">horas</option><option value="dias">días</option><option value="semanas">semanas</option></select></div></div>
    </div>
    <% for (const lado of [['inferior', 'Límite inferior', limiteInferiorRelativo], ['superior', 'Límite superior', limiteSuperiorRelativo]]) { %>
      <div class="col-12 col-lg-6" data-relativo-intervalo hidden><div class="border rounded p-3 h-100"><span class="form-label d-block"><%= lado[1] %></span><div class="row g-2"><div class="col-5"><select class="form-select" name="relativo_<%= lado[0] %>_direccion" data-relativo-direccion><% for (const direccion of [['pasado', 'En el pasado'], ['ahora', 'Ahora'], ['futuro', 'En el futuro']]) { %><option value="<%= direccion[0] %>" <%= lado[2].direccion === direccion[0] ? 'selected' : '' %>><%= direccion[1] %></option><% } %></select></div><div class="col-3"><input class="form-control" name="relativo_<%= lado[0] %>_magnitud" inputmode="numeric" pattern="[0-9]+" value="<%= lado[2].segundos %>" aria-label="Magnitud <%= lado[1].toLowerCase() %>" data-relativo-magnitud></div><div class="col-4"><select class="form-select" name="relativo_<%= lado[0] %>_unidad" aria-label="Unidad <%= lado[1].toLowerCase() %>" data-relativo-unidad><option value="segundos">segundos</option><option value="minutos">minutos</option><option value="horas">horas</option><option value="dias">días</option><option value="semanas">semanas</option></select></div></div></div></div>
    <% } %>
    <div class="col-12"><details data-relativo-histeresis><summary>Histéresis avanzada</summary><p class="form-text">Evita oscilaciones cuando la fecha está justo junto a un límite. Cero desactiva el margen.</p><div class="row g-3 mt-1">
      <div class="col-12 col-md-6" data-relativo-histeresis-simple><label class="form-label">Margen</label><div class="input-group"><input class="form-control" name="relativo_histeresis" inputmode="numeric" pattern="[0-9]+" value="<%= configuracionActual.histeresisSegundos ?? '0' %>" data-relativo-magnitud><select class="form-select" name="relativo_histeresis_unidad" aria-label="Unidad de histéresis" data-relativo-unidad><option value="segundos">segundos</option><option value="minutos">minutos</option><option value="horas">horas</option><option value="dias">días</option><option value="semanas">semanas</option></select></div></div>
      <div class="col-12 col-md-6" data-relativo-histeresis-intervalo hidden><label class="form-label">Margen inferior</label><div class="input-group"><input class="form-control" name="relativo_histeresis_inferior" inputmode="numeric" pattern="[0-9]+" value="<%= configuracionActual.histeresisInferiorSegundos ?? '0' %>" data-relativo-magnitud><select class="form-select" name="relativo_histeresis_inferior_unidad" aria-label="Unidad de histéresis inferior" data-relativo-unidad><option value="segundos">segundos</option><option value="minutos">minutos</option><option value="horas">horas</option><option value="dias">días</option><option value="semanas">semanas</option></select></div></div>
      <div class="col-12 col-md-6" data-relativo-histeresis-intervalo hidden><label class="form-label">Margen superior</label><div class="input-group"><input class="form-control" name="relativo_histeresis_superior" inputmode="numeric" pattern="[0-9]+" value="<%= configuracionActual.histeresisSuperiorSegundos ?? '0' %>" data-relativo-magnitud><select class="form-select" name="relativo_histeresis_superior_unidad" aria-label="Unidad de histéresis superior" data-relativo-unidad><option value="segundos">segundos</option><option value="minutos">minutos</option><option value="horas">horas</option><option value="dias">días</option><option value="semanas">semanas</option></select></div></div>
    </div></details></div>
    <div class="col-12"><div class="alert alert-info mb-0" role="status" aria-live="polite" data-relativo-resumen></div></div>
  </div>
</fieldset>
<div class="col-12 col-md-4" data-campo-valor><label class="form-label">Valor esperado</label><input class="form-control" name="valor_esperado" value="<%= configuracionActual.valorEsperado ?? '' %>"></div>
<div class="col-12 col-md-4" data-campo-calidad><label class="form-label">Calidad esperada</label><select class="form-select" name="calidad_esperada"><% for (const calidad of [['valida', 'Válida'], ['incierta', 'Incierta'], ['invalida', 'Inválida']]) { %><option value="<%= calidad[0] %>" <%= configuracionActual.calidadEsperada === calidad[0] ? 'selected' : '' %>><%= calidad[1] %></option><% } %></select></div>
<div class="col-12" data-campo-regex hidden>
  <div class="row g-3">
    <div class="col-12 col-md-4"><label class="form-label" for="regla-regex-modo">Resultado del patrón</label><select class="form-select" id="regla-regex-modo" name="regex_modo" data-regla-regex-modo><% for (const modo of [['existe', 'Existe alguna coincidencia'], ['conteo', 'Contar coincidencias']]) { %><option value="<%= modo[0] %>" <%= (configuracionActual.modo || 'existe') === modo[0] ? 'selected' : '' %>><%= modo[1] %></option><% } %></select></div>
    <div class="col-12 col-md-4" data-campo-regex-conteo hidden><label class="form-label" for="regla-regex-umbral">Umbral entero</label><input class="form-control" id="regla-regex-umbral" type="number" min="0" max="9007199254740991" step="1" name="regex_umbral" value="<%= configuracionActual.umbral ?? '' %>" data-regla-regex-umbral></div>
    <div class="col-12"><label class="form-label" for="regla-regex-patron">Patrón RE2</label><textarea class="form-control font-monospace" id="regla-regex-patron" name="regex_patron" rows="2" spellcheck="false" data-regla-regex-patron><%= configuracionActual.patron ?? '' %></textarea></div>
    <div class="col-12"><div class="d-flex flex-wrap gap-3" aria-label="Opciones del patrón">
      <% for (const opcion of [['i', 'Ignorar mayúsculas'], ['m', 'Modo multilínea'], ['s', 'Punto incluye salto de línea']]) { %>
        <div class="form-check"><input class="form-check-input" type="checkbox" name="regex_opciones" value="<%= opcion[0] %>" id="regla-regex-opcion-<%= opcion[0] %>" <%= configuracionActual.opciones?.includes(opcion[0]) ? 'checked' : '' %> data-regla-regex-opcion><label class="form-check-label" for="regla-regex-opcion-<%= opcion[0] %>"><code><%= opcion[0] %></code> · <%= opcion[1] %></label></div>
      <% } %>
    </div><div class="form-text" data-regla-regex-ayuda>RE2 seguro. La validación contractual se realizará en Sentinelia.</div></div>
    <div class="col-12"><label class="form-label" for="regla-regex-muestra">Muestra controlada para comprobar</label><textarea class="form-control" id="regla-regex-muestra" name="regex_muestra" rows="3" data-regla-regex-muestra></textarea><div class="form-text" data-regla-regex-muestra-ayuda>0/2048 caracteres Unicode. La muestra no se guardará en la revisión ni se devolverá completa.</div></div>
  </div>
</div>
<div class="col-12 col-md-4"><label class="form-label">Nivel de atención sugerido</label><input class="form-control" name="severidad_calculada" maxlength="32" value="<%= revision?.severidadCalculada || 'advertencia' %>" required></div>
<div class="col-12 col-md-8"><label class="form-label">Mensaje cuando se cumpla</label><input class="form-control" name="mensaje_operativo" maxlength="512" value="<%= revision?.mensajeOperativo || '' %>" required></div>
<div class="col-12"><div class="alert alert-light border mb-0" data-regla-preview>Comprueba la condición para confirmar cómo se interpretará.</div></div>
<div class="col-12 d-flex gap-2"><button class="btn btn-outline-secondary" type="button" data-regla-previsualizar>Comprobar condición</button><button class="btn btn-primary" type="submit"><%= revision ? 'Guardar nueva versión' : 'Crear regla de interpretación' %></button></div>
