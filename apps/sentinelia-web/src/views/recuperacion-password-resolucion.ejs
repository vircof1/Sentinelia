<%- include('parciales/cabecera', { titulo, usuarioActual: null }) %>

<section class="panel-acceso">
  <div class="acceso-layout">
    <section class="acceso-intro card border-0 shadow-lg h-100">
      <div class="card-body acceso-intro__cuerpo d-grid gap-4 p-4 p-lg-5">
        <div class="acceso-marca">
          <div class="acceso-marca__logo" aria-hidden="true">
            <img src="/IMG/Sentinelia.svg" alt="">
          </div>
          <div class="acceso-marca__textos">
            <strong><%= nombrePortalVisible || 'Sentinelia' %></strong>
            <small>Portal operativo</small>
          </div>
        </div>
        <div class="d-grid gap-2 align-content-start">
          <h1>Continuar recuperación</h1>
          <p class="texto-apoyo mb-0">
            El enlace demuestra acceso al correo. Ahora indica qué cuenta quieres recuperar.
          </p>
        </div>
      </div>
    </section>

    <div class="caja-acceso card border-0 shadow-lg">
      <div class="card-body caja-acceso__cuerpo p-4 p-lg-5">
        <div class="d-grid gap-1 mb-4">
          <h2 class="mb-0">Identificar la cuenta</h2>
          <p class="texto-ayuda-acceso mb-0">Escribe el nombre de usuario exacto.</p>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger mb-4" role="alert"><%= error %></div>
        <% } %>
        <% if (mensaje) { %>
          <div class="alert <%= completada ? 'alert-success' : 'alert-warning' %> mb-4" role="status"><%= mensaje %></div>
        <% } %>
        <% if (resuelta && !completada) { %>
          <div class="alert alert-success mb-4" role="status">
            Cuenta comprobada. Elige ahora una contraseña nueva.
          </div>
        <% } %>

        <% if (disponible && !resuelta) { %>
          <form method="post" action="/recuperacion-password/continuar" class="formulario-acceso">
            <input type="hidden" name="_csrf" value="<%= tokenCSRFPortal %>">
            <div>
              <label for="usuario" class="form-label">Nombre de usuario</label>
              <input
                id="usuario"
                name="usuario"
                type="text"
                class="form-control form-control-lg"
                autocomplete="username"
                minlength="3"
                maxlength="80"
                pattern="[A-Za-z0-9._\-]+"
                value="<%= formulario.usuario %>"
                required
                autofocus
              >
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 boton-acceso-submit">Comprobar cuenta</button>
          </form>
        <% } %>

        <% if (disponible && resuelta && !completada) { %>
          <form method="post" action="/recuperacion-password/password" class="formulario-acceso">
            <input type="hidden" name="_csrf" value="<%= tokenCSRFPortal %>">
            <div>
              <label for="password_nuevo" class="form-label">Nueva contraseña</label>
              <input id="password_nuevo" name="password_nuevo" type="password" class="form-control form-control-lg" autocomplete="new-password" required autofocus>
            </div>
            <div>
              <label for="password_confirmacion" class="form-label">Confirmar contraseña</label>
              <input id="password_confirmacion" name="password_confirmacion" type="password" class="form-control form-control-lg" autocomplete="new-password" required>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 boton-acceso-submit">Sustituir contraseña</button>
          </form>
        <% } %>

        <a class="btn btn-outline-secondary w-100 mt-3" href="/login">Volver al acceso</a>
      </div>
    </div>
  </div>
</section>

<%- include('parciales/pie') %>
