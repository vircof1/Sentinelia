<%- include('parciales/cabecera', { titulo, usuarioActual: null }) %>

<section class="panel-acceso">
  <div class="acceso-layout">
    <section class="acceso-intro card border-0 shadow-lg h-100">
      <div class="card-body acceso-intro__cuerpo d-grid gap-4 p-4 p-lg-5">
        <div class="acceso-marca">
          <div class="acceso-marca__logo" aria-hidden="true">
            <img src="/IMG/Sentinelia.svg" alt="">
          </div>
          <div class="acceso-marca__textos">
            <strong><%= nombrePortalVisible || 'Sentinelia' %></strong>
            <small>Portal operativo</small>
          </div>
        </div>
        <div class="d-grid gap-2 align-content-start">
          <h1>Recuperar contraseña</h1>
          <p class="texto-apoyo mb-0">
            Si existen cuentas recuperables asociadas a tu correo, recibirás las instrucciones necesarias.
          </p>
        </div>
      </div>
    </section>

    <div class="caja-acceso card border-0 shadow-lg">
      <div class="card-body caja-acceso__cuerpo p-4 p-lg-5">
        <div class="d-grid gap-1 mb-4">
          <h2 class="mb-0">Solicitar recuperación</h2>
          <p class="texto-ayuda-acceso mb-0">Indica la dirección de correo previamente validada.</p>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger mb-4" role="alert"><%= error %></div>
        <% } %>
        <% if (mensaje) { %>
          <div class="alert <%= completada ? 'alert-success' : 'alert-warning' %> mb-4" role="status"><%= mensaje %></div>
        <% } %>

        <% if (disponible && !completada) { %>
          <form
            method="post"
            action="/recuperar-password"
            class="formulario-acceso"
            data-formulario-pow
            data-pow-endpoint="/recuperar-password/pow/desafio"
          >
            <input type="hidden" name="_csrf" value="<%= tokenCSRFPortal %>">
            <div>
              <label for="email" class="form-label">Correo electrónico</label>
              <input
                id="email"
                name="email"
                type="email"
                class="form-control form-control-lg"
                autocomplete="email"
                value="<%= formulario.email %>"
                required
              >
            </div>

            <input type="hidden" name="pow_desafio_id" value="">
            <input type="hidden" name="pow_nonce" value="">
            <input type="hidden" name="pow_duracion_ms" value="">
            <input type="hidden" name="pow_hashrate_cliente" value="">

            <div
              class="estado-pow alert alert-light border mb-0"
              data-pow-estado
              hidden
              aria-live="polite"
            ></div>

            <button type="submit" class="btn btn-primary btn-lg w-100 boton-acceso-submit" data-boton-pow>Enviar instrucciones</button>
          </form>
        <% } %>

        <a class="btn btn-outline-secondary w-100 mt-3" href="/login">Volver al acceso</a>
      </div>
    </div>
  </div>
</section>

<% if (disponible && !completada) { %>
  <script src="/js/login.js"></script>
<% } %>

<%- include('parciales/pie') %>
