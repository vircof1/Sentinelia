<%- include('parciales/cabecera', { titulo, usuarioActual }) %>

<%
  const dashboard = dashboardOperativo || null;
  const dashboardResumen = dashboard?.resumenMonitores || null;
  const dashboardResumenDns = dashboard?.resumenDns || null;
  const dashboardResumenRuntime = dashboard?.resumenRuntime || null;
  const dashboardSalud = dashboard?.resumenSalud || null;
  const totalProblemas = Number(dashboardResumen?.totalIndisponiblesAlertables || 0) + Number(dashboardResumen?.totalDegradadosAlertables || 0);
  const totalAlertasHero = Number(dashboardResumen?.totalAlertasActivas || 0);
  const totalAlertasVisiblesHero = Number(dashboardResumen?.totalAlertasVisibles ?? dashboardResumen?.totalAlertasActivas ?? 0);
  const totalAlertasDescartadasHero = Number(dashboardResumen?.totalAlertasDescartadas || 0);
  const detalleAlertasHero = totalAlertasVisiblesHero > 0
    ? `${totalAlertasVisiblesHero} ${totalAlertasVisiblesHero === 1 ? 'requiere' : 'requieren'} atención ahora.`
    : (totalAlertasHero > 0
      ? `Ninguna en el foco; ${totalAlertasHero} ${totalAlertasHero === 1 ? 'permanece activa e inhibida' : 'permanecen activas e inhibidas'}.`
      : 'Ninguna requiere atención.');
  const totalPendientesHero = Number(dashboardResumen?.totalPendientes || 0);
  const totalMonitoresHero = Number(dashboardResumen?.totalMonitores || 0);
  const totalMonitoresActivosHero = Number(dashboardResumen?.totalActivos || 0);
  const tonoDashboard = dashboardSalud?.tono === 'ok'
    ? 'ok'
    : (dashboardSalud?.tono === 'advertencia'
      ? 'advertencia'
      : (dashboardSalud?.tono === 'pendiente' ? 'suave' : 'alerta'));
  const tonoIncidenciasHero = !dashboard?.habilitado
    ? 'suave'
    : (totalProblemas > 0
      ? 'advertencia'
      : (totalAlertasDescartadasHero > 0 || totalPendientesHero > 0 ? 'advertencia' : 'ok'));
  const tonoCorreoHero = estadoCorreo.operativo
    ? 'ok'
    : 'advertencia';
  const tonoDnsHero = !dashboardResumenDns?.habilitado
    ? 'suave'
    : (Number(dashboardResumenDns?.totalRegistros || 0) > 0
      ? 'ok'
      : (Number(dashboardResumenDns?.totalZonas || 0) > 0 ? 'neutro' : 'suave'));
  const tonoBadgeAlertasHero = !dashboard?.habilitado
    ? ''
    : (totalAlertasVisiblesHero > 0 ? 'insignia--alerta' : (totalAlertasDescartadasHero > 0 || totalPendientesHero > 0 ? 'insignia--advertencia' : 'insignia--ok'));
  const tonoResumenMonitores = 'neutro';
  const tonoResumenDisponibles = Number(dashboardResumen?.totalDisponibles || 0) > 0 ? 'ok' : 'suave';
  const tonoResumenIncidencias = totalProblemas > 0 ? 'advertencia' : 'ok';
  const tonoResumenPendientes = Number(dashboardResumen?.totalPendientes || 0) > 0 ? 'advertencia' : 'suave';
  const tonoResumenAlertas = totalAlertasVisiblesHero > 0 ? 'alerta' : (totalAlertasDescartadasHero > 0 ? 'advertencia' : 'ok');
  const alertasVisiblesDashboard = Array.isArray(dashboard?.alertasDestacadas) ? dashboard.alertasDestacadas : [];
  const alertasDescartadasDashboard = Array.isArray(dashboard?.alertasDescartadas) ? dashboard.alertasDescartadas : [];
  const puedeGestionarDescartesDashboard = Boolean(
    dashboard?.permisosOperativos?.puedeGestionarDescartesAlertasActivas ||
    accionesDisponibles?.gestionarDescartesAlertasActivas
  );
  const totalRuntimeHero = Number(dashboardResumenRuntime?.totalInstanciasActivas || 0);
  const runtimeActivoHero = totalRuntimeHero > 0;
  const runtimeVerificableHero = dashboardResumenRuntime?.disponible === true;
  const coberturaScope = alcancePanel?.cobertura || 'Cobertura no resuelta';
  const alertasRemotasDashboard = dashboard?.alertasRemotas || { permiso: false, preferencia: false, puedeGestionarDescartes: false, alertasVisibles: [], alertasDescartadas: [], alertasSinVigencia: [] };
  const etiquetaEstadoAlertaRemota = (alerta) => {
    if (alerta?.descarteLocal?.vigente) return 'Inhibida localmente';
    if (alerta?.estadoPresentacion === 'activaEnOrigen') return 'Activa en origen';
    if (alerta?.estadoPresentacion === 'vigenciaAgotada') return 'Información caducada';
    return 'Estado no disponible';
  };
  const etiquetaAlcanceRemoto = (nivel) => ({
    portal: 'Portal completo',
    tenant: 'Tenant',
    empresa: 'Empresa',
    sitio: 'Sitio'
  }[String(nivel || '').trim()] || 'No indicado');
  const urlMonitorRemotoDashboard = (alerta) =>
    `/federacion/datos-remotos?procedencia=${encodeURIComponent(alerta.installationOrigenId)}` +
    `&vista=monitores&subvista=estado&monitor=${encodeURIComponent(alerta.monitorOrigenId)}`;
%>

<section
  class="panel-general"
  data-dashboard-shell
  data-url-dashboard="/panel/api/dashboard"
  data-url-dashboard-ws="/ws/panel-dashboard"
  data-url-alertas-base="/panel/api/alertas-activas"
  data-dashboard-tiempo-real="<%= dashboard?.habilitado || alertasRemotasDashboard.permiso || contextoUsuarioActual?.permisos?.verAvisosPlataforma ? 'true' : 'false' %>"
  data-puede-gestionar-descartes="<%= puedeGestionarDescartesDashboard ? '1' : '0' %>"
>
  <section class="hero-operativo card border-0 shadow-lg overflow-hidden">
    <div class="card-body hero-operativo__cuerpo p-4">
      <div class="hero-operativo__contenido row g-3">
        <div class="col-12">
          <div class="hero-operativo__textos">
            <h1>Alertas operativas</h1>
            <p data-dashboard-hero-detalle>
              <%= dashboard?.habilitado
                ? 'Estado actual de los monitores y sus alertas.'
                : 'La sesión está activa, pero no tiene lectura operativa de monitores.' %>
            </p>
          </div>
        </div>

        <div class="col-12">
          <div class="hero-operativo__metricas row g-3">
            <div class="col-12 col-md-6 col-xl-3">
              <article class="card resumen-card resumen-card--<%= runtimeActivoHero ? (dashboard?.habilitado && totalMonitoresHero > 0 ? 'ok' : 'suave') : (runtimeVerificableHero ? 'alerta' : 'advertencia') %> h-100 border-0 shadow-sm" data-dashboard-hero-card-supervision>
                <div class="card-body resumen-card__body">
                  <span class="etiqueta panel-etiqueta-icono">
                    <i class="bi bi-broadcast" aria-hidden="true"></i><span>Monitores en supervisión</span>
                    <button type="button" class="resumen-card__ayuda" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Monitores activos dentro de tu alcance. Solo están bajo supervisión efectiva cuando el motor de supervisión está funcionando." aria-label="Qué significa monitores en supervisión"><i class="bi bi-info-circle" aria-hidden="true"></i></button>
                  </span>
                  <strong data-dashboard-hero-supervision><%= runtimeActivoHero ? (dashboard?.habilitado ? totalMonitoresActivosHero : 'Sin acceso') : (runtimeVerificableHero ? 'Detenida' : 'Sin verificar') %></strong>
                  <small data-dashboard-hero-supervision-detalle>
                    <% if (runtimeActivoHero && dashboard?.habilitado) { %>
                      <%= totalMonitoresActivosHero %> monitores activos de <%= totalMonitoresHero %> visibles · <%= totalRuntimeHero %> proceso<%= totalRuntimeHero === 1 ? '' : 's' %> de supervisión.
                    <% } else if (runtimeActivoHero) { %>
                      El motor de supervisión está activo, pero no puedes consultar los monitores.
                    <% } else if (!runtimeVerificableHero) { %>
                      No puede confirmarse si el motor está ejecutando la supervisión.
                    <% } else if (dashboard?.habilitado && totalMonitoresActivosHero > 0) { %>
                      <%= totalMonitoresActivosHero %> monitores activos no se están ejecutando.
                    <% } else { %>
                      No hay ningún proceso ejecutando la supervisión.
                    <% } %>
                  </small>
                </div>
              </article>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
              <article class="card resumen-card resumen-card--<%= !dashboard?.habilitado || dashboardResumen.totalMonitores === 0 ? 'suave' : tonoResumenAlertas %> h-100 border-0 shadow-sm" data-dashboard-hero-card-alertas>
                <div class="card-body resumen-card__body">
                  <span class="etiqueta panel-etiqueta-icono">
                    <i class="bi bi-bell-fill" aria-hidden="true"></i><span>Alertas visibles</span>
                    <button type="button" class="resumen-card__ayuda" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Alertas activas que forman parte de tu foco actual. No incluye las alertas retiradas temporalmente mediante una inhibición operativa." aria-label="Qué significa alertas visibles"><i class="bi bi-info-circle" aria-hidden="true"></i></button>
                  </span>
                  <strong data-dashboard-hero-alertas-visibles><%= dashboard?.habilitado ? totalAlertasVisiblesHero : '-' %></strong>
                  <small data-dashboard-hero-alertas-detalle><%= dashboard?.habilitado ? detalleAlertasHero : 'Sin lectura operativa.' %></small>
                </div>
              </article>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
              <article class="card resumen-card resumen-card--<%= !dashboard?.habilitado || dashboardResumen.totalMonitores === 0 ? 'suave' : (totalAlertasDescartadasHero > 0 ? 'advertencia' : 'ok') %> h-100 border-0 shadow-sm" data-dashboard-hero-card-descartadas>
                <div class="card-body resumen-card__body">
                  <span class="etiqueta panel-etiqueta-icono">
                    <i class="bi bi-bell-slash" aria-hidden="true"></i><span>Alertas inhibidas</span>
                    <button type="button" class="resumen-card__ayuda" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Alertas que continúan activas, pero se han retirado del foco mediante una inhibición temporal o indefinida. No están resueltas ni cerradas." aria-label="Qué significa alertas inhibidas"><i class="bi bi-info-circle" aria-hidden="true"></i></button>
                  </span>
                  <strong data-dashboard-hero-alertas-descartadas><%= dashboard?.habilitado ? totalAlertasDescartadasHero : '-' %></strong>
                  <small>Siguen activas, pero están fuera del foco por inhibición operativa.</small>
                </div>
              </article>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
              <article class="card resumen-card resumen-card--<%= !dashboard?.habilitado || dashboardResumen.totalMonitores === 0 ? 'suave' : (totalPendientesHero > 0 ? 'advertencia' : 'ok') %> h-100 border-0 shadow-sm" data-dashboard-hero-card-pendientes>
                <div class="card-body resumen-card__body">
                  <span class="etiqueta panel-etiqueta-icono">
                    <i class="bi bi-hourglass-split" aria-hidden="true"></i><span>Monitores pendientes</span>
                    <button type="button" class="resumen-card__ayuda" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Monitores que todavía no han completado su primera evaluación y aún no tienen un estado operativo." aria-label="Qué significa monitores pendientes"><i class="bi bi-info-circle" aria-hidden="true"></i></button>
                  </span>
                  <strong data-dashboard-hero-pendientes><%= dashboard?.habilitado ? totalPendientesHero : '-' %></strong>
                  <small>Todavía no han completado su primera evaluación.</small>
                </div>
              </article>
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="hero-etiquetas" aria-label="Estado de servicios auxiliares">
            <span class="insignia"><i class="bi bi-globe2" aria-hidden="true"></i><span>DNS: <strong data-dashboard-hero-dns><%= dashboardResumenDns?.habilitado ? `${dashboardResumenDns.totalZonas} zonas` : 'sin acceso' %></strong></span></span>
            <span class="insignia insignia--<%= tonoCorreoHero %>"><i class="bi <%= estadoCorreo.operativo ? 'bi-envelope-check' : 'bi-envelope-exclamation' %>" aria-hidden="true"></i><span>Correo: <strong><%= estadoCorreo.operativo ? 'operativo' : estadoCorreo.configurado ? 'sin verificar' : 'pendiente' %></strong></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resumen de monitores oculto temporalmente: sus métricas ya están sintetizadas en el hero.
  <section class="seccion-panel">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 pb-0">
