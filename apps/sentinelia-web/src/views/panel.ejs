            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>
  -->

  <section class="seccion-panel">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 pb-0">
        <div class="seccion-cabecera mb-0">
          <div>
            <h2 class="d-inline-flex align-items-center gap-2"><i class="bi bi-bell" aria-hidden="true"></i><span>Alertas activas</span></h2>
            <p class="texto-apoyo mb-0">
              Problemas abiertos que siguen vigentes para esta sesión y su alcance visible.
            </p>
          </div>
        </div>
      </div>
      <div class="card-body pt-3">
        <div data-dashboard-alertas-contenido>
          <% if (!dashboard?.habilitado) { %>
            <div class="tarjeta">
              <p class="texto-apoyo">La sesión no tiene permiso para inspeccionar alertas activas de monitores.</p>
            </div>
          <% } else { %>
            <div class="dashboard-alertas-operativas">
              <% if (!runtimeActivoHero) { %>
                <article class="dashboard-alerta-plataforma" role="alert">
                  <span class="dashboard-alerta-plataforma__icono" aria-hidden="true"><i class="bi bi-cpu"></i></span>
                  <div class="dashboard-alerta-plataforma__contenido">
                    <div class="fila-monitor__etiquetas">
                      <span class="insignia-monitor insignia-monitor--alerta">Plataforma</span>
                      <span class="insignia-monitor insignia-monitor--suave"><%= runtimeVerificableHero ? 'Supervisión detenida' : 'Estado no verificable' %></span>
                    </div>
                    <h3><%= runtimeVerificableHero ? 'El motor de supervisión está detenido' : 'No se puede verificar el motor de supervisión' %></h3>
                    <p>
                      <% if (runtimeVerificableHero && totalMonitoresActivosHero > 0) { %>
                        Hay <strong><%= totalMonitoresActivosHero %> monitores activos</strong> configurados, pero el proceso que debe evaluarlos no está funcionando.
                      <% } else if (runtimeVerificableHero) { %>
                        No hay ningún proceso ejecutando la supervisión. Los monitores no se evaluarán hasta que el motor vuelva a arrancar.
                      <% } else if (totalMonitoresActivosHero > 0) { %>
                        No puede confirmarse que los <strong><%= totalMonitoresActivosHero %> monitores activos</strong> se estén evaluando.
                      <% } else { %>
                        No puede confirmarse que el motor de supervisión esté funcionando.
                      <% } %>
                    </p>
                  </div>
                </article>
              <% } %>
              <% if (alertasVisiblesDashboard.length === 0) { %>
                <div class="tarjeta">
                  <div class="fila-monitor__etiquetas" style="margin-bottom: 12px;">
                    <span class="insignia-monitor insignia-monitor--<%= tonoDashboard %>">Sin alertas de monitores</span>
                  </div>
                  <p class="texto-apoyo"><%= dashboardSalud?.detalle || 'No hay alertas activas visibles en este momento.' %></p>
                </div>
              <% } else { %>
                <div class="table-responsive dashboard-alertas-tabla-wrap">
                  <table class="table table-striped table-hover align-middle mb-0 tabla-alertas-operativas">
                    <thead>
                      <tr>
                        <th>Monitor</th>
                        <th>Estado actual</th>
                        <th>Alerta activa</th>
                        <th>Seguimiento</th>
                        <th class="text-end">Acciones</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% for (const alerta of alertasVisiblesDashboard) { %>
                        <% const tonoAlerta = alerta.resumenHumano?.tono === 'ok'
                          ? 'ok'
                          : (alerta.resumenHumano?.tono === 'advertencia' ? 'advertencia' : 'alerta'); %>
                        <tr>
                          <td>
                            <div class="d-grid gap-2">
                              <strong><%= alerta.monitorNombre %></strong>
                              <div class="fila-monitor__etiquetas">
                                <span class="insignia-monitor insignia-monitor--<%= alerta.tipoMonitor || 'base' %>"><%= String(alerta.tipoMonitor || '').toUpperCase() %></span>
                                <span class="insignia-monitor insignia-monitor--suave">#<%= alerta.monitorId %></span>
                                <span class="insignia-monitor <%= alerta.monitorActivo ? 'insignia-monitor--ok' : 'insignia-monitor--off' %>"><%= alerta.monitorActivo ? 'Monitor activo' : 'Monitor inactivo' %></span>
                                <% if (alerta.causalidadFederada?.contieneEntradasFederadas) { %>
                                  <span class="insignia-monitor insignia-monitor--federada">Datos de otra instalación</span>
                                <% } %>
                              </div>
                              <span class="etiqueta-secundaria">
                                <%= alerta.empresaNombre || '-' %><% if (alerta.sitioNombre) { %> · <%= alerta.sitioNombre %><% } %>
                              </span>
                            </div>
                          </td>
                          <td>
                            <div class="d-grid gap-2">
                              <span class="insignia-monitor insignia-monitor--<%= tonoAlerta %>"><%= alerta.resumenHumano?.etiquetaEstado || alerta.estadoDetectado %></span>
                              <span class="etiqueta-secundaria"><%= alerta.resumenHumano?.detalle || alerta.mensajeUltimoResultado || 'Sin detalle operativo adicional.' %></span>
                            </div>
                          </td>
                          <td>
                            <div class="metadatos-configuracion">
                              <span>Visibilidad: <code>visible en el foco principal</code></span>
                              <span>Destino: <code><%= alerta.protocolo?.host || alerta.destinoPrincipal || '-' %><% if (alerta.protocolo?.puerto) { %>:<%= alerta.protocolo.puerto %><% } %></code></span>
                              <span>Resultado: <code><%= alerta.codigoUltimoResultado || 'sin_resultado' %></code></span>
                            </div>
                            <% if (alerta.causalidadFederada?.contieneEntradasFederadas) { %>
                              <details class="dashboard-causalidad-federada mt-2">
                                <summary>Ver origen de los datos (<%= alerta.causalidadFederada.totalEntradas %>)</summary>
                                <ul class="mt-2 mb-0">
                                  <% for (const entrada of alerta.causalidadFederada.entradas) { %>
                                    <li>
                                      Dato <code><%= entrada.variable %></code> ·
                                      <% if (entrada.visibilidad === 'visible') { %>
                                        <a href="<%= entrada.urlProyeccionRemota %>">ver monitor de origen</a>
                                      <% } else { %>
                                        <span>origen no disponible con tu alcance actual</span>
                                      <% } %>
                                    </li>
                                  <% } %>
                                </ul>
                              </details>
                            <% } %>
                          </td>
                          <td>
                            <div class="metadatos-configuracion">
                              <span>Repeticiones: <code><%= alerta.contadorRepeticiones %></code></span>
                              <span>Desde: <code><time data-fecha-utc="<%= alerta.validoDesdeUtc %>"><%= alerta.validoDesdeUtc %></time></code></span>
                              <span>Última confirmación: <code><time data-fecha-utc="<%= alerta.ultimaConfirmacionUtc %>"><%= alerta.ultimaConfirmacionUtc %></time></code></span>
                              <span>Última ejecución: <code><time data-fecha-utc="<%= alerta.ultimaEjecucionUtc %>"><%= alerta.ultimaEjecucionUtc %></time></code></span>
                            </div>
                          </td>
                          <td class="text-end">
                            <div class="dropup tabla-acciones">
                              <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm tabla-acciones__toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Acciones de la alerta de <%= alerta.monitorNombre || 'Monitor' %>"
                              >
                                <i class="bi bi-gear" aria-hidden="true"></i>
                              </button>
                              <div class="dropdown-menu dropdown-menu-end tabla-acciones__menu">
                                <a href="/monitores/<%= alerta.monitorId %>?return_to=<%= encodeURIComponent('/panel') %>" class="dropdown-item d-flex align-items-center gap-2">
                                  <i class="bi bi-eye" aria-hidden="true"></i>
                                  <span>Ver monitor</span>
                                </a>
                                <% if (puedeGestionarDescartesDashboard) { %>
                                  <button
                                    type="button"
                                    class="dropdown-item dropdown-item--warning d-flex align-items-center gap-2"
                                    data-dashboard-descartar-alerta
                                    data-monitor-id="<%= alerta.monitorId %>"
                                    data-monitor-nombre="<%= alerta.monitorNombre || 'Monitor' %>"
                                  >
                                    <i class="bi bi-bell-slash" aria-hidden="true"></i>
                                    <span>Inhibir…</span>
                                  </button>
                                <% } %>
                              </div>
                            </div>
                          </td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              <% } %>

              <% if (alertasDescartadasDashboard.length > 0) { %>
                <details class="dashboard-alertas-descartadas">
                  <summary class="dashboard-alertas-descartadas__cabecera">
                    <div>
                      <span class="etiqueta panel-etiqueta-icono"><i class="bi bi-bell-slash" aria-hidden="true"></i><span>Alertas inhibidas</span></span>
                      <p class="texto-apoyo mb-0">Siguen activas y registrando actividad, pero no aparecen en el foco principal hasta que finalice o se revierta la inhibición.</p>
                    </div>
                    <span class="dashboard-alertas-descartadas__acciones">
                      <span class="insignia-monitor insignia-monitor--advertencia"><%= alertasDescartadasDashboard.length %> inhibidas</span>
                      <span class="dashboard-alertas-descartadas__chevron" aria-hidden="true"><i class="bi bi-chevron-down"></i></span>
                    </span>
                  </summary>
                  <div class="dashboard-alertas-descartadas__lista">
                    <% for (const alerta of alertasDescartadasDashboard) { %>
                      <% const descarte = alerta.descarteOperativo || {}; %>
                      <%
                        const usuarioDescarte = descarte.usuario || null;
                        const nombreUsuarioDescarte = String(usuarioDescarte?.nombreVisible || usuarioDescarte?.usuario || '').trim();
                        const loginUsuarioDescarte = String(usuarioDescarte?.usuario || '').trim();
                      %>
                      <article class="alerta-descartada-card">
                        <div class="alerta-descartada-card__principal">
                          <div class="d-grid gap-2">
                            <strong><%= alerta.monitorNombre || 'Monitor' %></strong>
                            <div class="fila-monitor__etiquetas">
                              <span class="insignia-monitor insignia-monitor--<%= alerta.tipoMonitor || 'base' %>"><%= String(alerta.tipoMonitor || '').toUpperCase() %></span>
                              <span class="insignia-monitor insignia-monitor--suave">#<%= alerta.monitorId %></span>
                              <span class="insignia-monitor insignia-monitor--advertencia">Inhibida</span>
                              <% if (alerta.causalidadFederada?.contieneEntradasFederadas) { %>
                                <span class="insignia-monitor insignia-monitor--federada">Datos de otra instalación</span>
                              <% } %>
                            </div>
                          </div>
                          <p class="dashboard-descarte-motivo"><%= descarte.motivo || 'Sin motivo informado.' %></p>
                          <div class="dashboard-descarte-meta">
                            <span>Desde: <code><time data-fecha-utc="<%= descarte.descartadaEnUtc || '' %>"><%= descarte.descartadaEnUtc || '-' %></time></code></span>
                            <span>Hasta: <code><% if (descarte.descartadaHastaUtc) { %><time data-fecha-utc="<%= descarte.descartadaHastaUtc %>"><%= descarte.descartadaHastaUtc %></time><% } else { %>indefinido<% } %></code></span>
                            <span>
                              Usuario:
                              <% if (nombreUsuarioDescarte) { %>
                                <strong><%= nombreUsuarioDescarte %></strong>
                                <% if (loginUsuarioDescarte && loginUsuarioDescarte !== nombreUsuarioDescarte) { %>
                                  <code>@<%= loginUsuarioDescarte %></code>
                                <% } %>
                              <% } else if (descarte.usuarioId) { %>
                                <span class="text-body-secondary">Usuario #<%= descarte.usuarioId %></span>
                              <% } else { %>
                                <span class="text-body-secondary">No informado</span>
                              <% } %>
                            </span>
                          </div>
                          <% if (alerta.causalidadFederada?.contieneEntradasFederadas) { %>
                            <details class="dashboard-causalidad-federada">
                              <summary>Ver origen de los datos (<%= alerta.causalidadFederada.totalEntradas %>)</summary>
                              <ul class="mt-2 mb-0">
                                <% for (const entrada of alerta.causalidadFederada.entradas) { %>
                                  <li>Dato <code><%= entrada.variable %></code> ·
                                    <% if (entrada.visibilidad === 'visible') { %>
                                      <a href="<%= entrada.urlProyeccionRemota %>">ver monitor de origen</a>
                                    <% } else { %>
                                      <span>origen no disponible con tu alcance actual</span>
                                    <% } %>
                                  </li>
                                <% } %>
                              </ul>
                            </details>
                          <% } %>
                        </div>
                        <div class="alerta-descartada-card__acciones">
                          <div class="dropup tabla-acciones tabla-acciones--auto">
                            <button
                              type="button"
                              class="btn btn-outline-secondary btn-sm tabla-acciones__toggle"
                              data-bs-toggle="dropdown"
                              aria-expanded="false"
                              aria-label="Acciones de la alerta inhibida de <%= alerta.monitorNombre || 'Monitor' %>"
                            >
                              <i class="bi bi-gear" aria-hidden="true"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end tabla-acciones__menu">
                              <a href="/monitores/<%= alerta.monitorId %>?return_to=<%= encodeURIComponent('/panel') %>" class="dropdown-item d-flex align-items-center gap-2">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                                <span>Ver monitor</span>
                              </a>
                              <% if (puedeGestionarDescartesDashboard) { %>
                                <button
                                  type="button"
                                  class="dropdown-item d-flex align-items-center gap-2"
                                  data-dashboard-revertir-descarte
                                  data-monitor-id="<%= alerta.monitorId %>"
                                  data-monitor-nombre="<%= alerta.monitorNombre || 'Monitor' %>"
                                >
                                  <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                  <span>Reactivar…</span>
                                </button>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </article>
                    <% } %>
                  </div>
                </details>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <% if (alertasRemotasDashboard.permiso) { %>
    <section class="seccion-panel">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pb-0">
          <div class="seccion-cabecera mb-0"><div>
            <h2 class="d-inline-flex align-items-center gap-2"><i class="bi bi-cloud-arrow-down" aria-hidden="true"></i><span>Alertas remotas</span></h2>
            <p class="texto-apoyo mb-0">Alertas recibidas desde otras instalaciones. Se evalúan en su instalación de origen.</p>
          </div></div>
        </div>
        <div class="card-body pt-3" data-dashboard-alertas-remotas>
          <% if (!alertasRemotasDashboard.preferencia) { %>
            <div class="tarjeta"><p class="texto-apoyo mb-2">Tienes permiso de consulta, pero estas alertas no se incluyen en el resumen principal según tu preferencia personal.</p><a href="/mi-perfil" class="btn btn-outline-secondary btn-sm">Configurar en mi perfil</a></div>
          <% } else if (alertasRemotasDashboard.alertasVisibles.length === 0) { %>
            <div class="tarjeta"><p class="texto-apoyo mb-0">No hay alertas remotas activas visibles dentro de tu alcance.</p></div>
          <% } else { %>
            <div class="dashboard-alertas-remotas-grid">
              <% for (const alerta of alertasRemotasDashboard.alertasVisibles) { %>
                <article class="tarjeta dashboard-alerta-remota dashboard-alerta-remota--<%= alerta.estadoPresentacion %>">
                  <div class="fila-monitor__etiquetas">
                    <span class="insignia-monitor insignia-monitor--alerta">Remota</span>
                    <span class="insignia-monitor insignia-monitor--<%= alerta.estadoPresentacion === 'activaEnOrigen' ? 'alerta' : 'advertencia' %>"><%= etiquetaEstadoAlertaRemota(alerta) %></span>
                  </div>
                  <h3><%= alerta.monitorNombre %></h3>
                  <p><%= alerta.payload.mensajeUltimoResultado || alerta.payload.estadoDetectado %></p>
                  <div class="metadatos-configuracion">
                    <span>Instalación: <code><%= alerta.installationNombre || alerta.installationOrigenId %></code></span>
                    <span>Alcance: <code><%= etiquetaAlcanceRemoto(alerta.scope.nivel) %></code></span>
                    <span>Última confirmación: <code><time data-fecha-utc="<%= alerta.frescura.ultimaConfirmacionUtc %>"><%= alerta.frescura.ultimaConfirmacionUtc %></time></code></span>
                  </div>
                  <div class="dropdown dashboard-alerta-remota__acciones">
                    <button type="button" class="btn btn-outline-secondary btn-sm tabla-acciones__toggle"
                      data-bs-toggle="dropdown" aria-expanded="false"
                      aria-label="Acciones de la alerta remota de <%= alerta.monitorNombre || 'Monitor remoto' %>">
                      <i class="bi bi-gear" aria-hidden="true"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end tabla-acciones__menu">
                      <a href="<%= urlMonitorRemotoDashboard(alerta) %>" class="dropdown-item d-flex align-items-center gap-2">
                        <i class="bi bi-eye" aria-hidden="true"></i><span>Ver monitor</span>
                      </a>
                      <% if (alertasRemotasDashboard.puedeGestionarDescartes) { %>
                        <button type="button" class="dropdown-item dropdown-item--warning d-flex align-items-center gap-2"
                          data-dashboard-descartar-alerta-remota data-proyeccion-id="<%= alerta.proyeccionId %>"
                          data-alerta-id="<%= alerta.alertaAuditoriaId %>"
                          data-monitor-nombre="<%= alerta.monitorNombre || 'Monitor remoto' %>"
                          data-installation-nombre="<%= alerta.installationNombre || alerta.installationOrigenId || 'la instalación remota' %>">
                          <i class="bi bi-bell-slash" aria-hidden="true"></i><span>Inhibir…</span>
                        </button>
                      <% } %>
                    </div>
                  </div>
                </article>
              <% } %>
            </div>
          <% } %>
          <% const alertasRemotasSecundarias = alertasRemotasDashboard.preferencia
            ? alertasRemotasDashboard.alertasDescartadas
            : []; %>
          <% if (alertasRemotasSecundarias.length > 0) { %>
            <details class="dashboard-alertas-descartadas mt-3">
              <summary class="dashboard-alertas-descartadas__cabecera">
                <strong>Alertas remotas inhibidas</strong>
                <span><%= alertasRemotasSecundarias.length %></span>
              </summary>
              <div class="dashboard-alertas-remotas-grid mt-2">
                <% for (const alerta of alertasRemotasSecundarias) { %>
                  <article class="tarjeta dashboard-alerta-remota dashboard-alerta-remota--<%= alerta.estadoPresentacion %>">
                    <div class="fila-monitor__etiquetas">
                      <span class="insignia-monitor insignia-monitor--alerta">Remota</span>
                      <span class="insignia-monitor insignia-monitor--advertencia"><%= etiquetaEstadoAlertaRemota(alerta) %></span>
                    </div>
                    <h3><%= alerta.monitorNombre %></h3>
                    <p><%= alerta.payload.mensajeUltimoResultado || alerta.payload.estadoDetectado %></p>
                    <div class="metadatos-configuracion">
                      <span>Instalación: <code><%= alerta.installationNombre || alerta.installationOrigenId %></code></span>
                      <span>Alcance: <code><%= etiquetaAlcanceRemoto(alerta.scope.nivel) %></code></span>
                    </div>
                    <% if (alerta.descarteLocal.vigente) { %>
                      <p class="texto-apoyo">Motivo de la inhibición local: <%= alerta.descarteLocal.motivo %></p>
                    <% } %>
                    <div class="dropdown dashboard-alerta-remota__acciones">
                      <button type="button" class="btn btn-outline-secondary btn-sm tabla-acciones__toggle"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        aria-label="Acciones de la alerta remota de <%= alerta.monitorNombre || 'Monitor remoto' %>">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                      </button>
                      <div class="dropdown-menu dropdown-menu-end tabla-acciones__menu">
                        <a href="<%= urlMonitorRemotoDashboard(alerta) %>" class="dropdown-item d-flex align-items-center gap-2">
                          <i class="bi bi-eye" aria-hidden="true"></i><span>Ver monitor</span>
                        </a>
                        <% if (alerta.descarteLocal.vigente && alertasRemotasDashboard.puedeGestionarDescartes) { %>
                          <button type="button" class="dropdown-item d-flex align-items-center gap-2"
                            data-dashboard-revertir-alerta-remota data-proyeccion-id="<%= alerta.proyeccionId %>"
                            data-alerta-id="<%= alerta.alertaAuditoriaId %>">
                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><span>Reactivar…</span>
                          </button>
                        <% } %>
                      </div>
                    </div>
                  </article>
                <% } %>
              </div>
            </details>
          <% } %>
          <% const alertasRemotasSinVigencia = alertasRemotasDashboard.preferencia &&
            Array.isArray(alertasRemotasDashboard.alertasSinVigencia)
              ? alertasRemotasDashboard.alertasSinVigencia
              : []; %>
          <% if (alertasRemotasSinVigencia.length > 0) { %>
            <details class="dashboard-alertas-descartadas mt-3">
              <summary class="dashboard-alertas-descartadas__cabecera">
                <strong>Alertas remotas con información caducada</strong>
                <span><%= alertasRemotasSinVigencia.length %></span>
              </summary>
              <p class="texto-apoyo mt-2 mb-2">La instalación de origen no comunicó el cierre y hace demasiado tiempo que no confirma estas alertas.</p>
              <div class="dashboard-alertas-remotas-grid">
                <% for (const alerta of alertasRemotasSinVigencia) { %>
                  <article class="tarjeta dashboard-alerta-remota dashboard-alerta-remota--vigenciaAgotada">
                    <div class="fila-monitor__etiquetas">
                      <span class="insignia-monitor insignia-monitor--alerta">Remota</span>
                      <span class="insignia-monitor insignia-monitor--advertencia">Información caducada</span>
                    </div>
                    <h3><%= alerta.monitorNombre %></h3>
                    <p><%= alerta.payload.mensajeUltimoResultado || alerta.payload.estadoDetectado %></p>
                    <div class="metadatos-configuracion">
                      <span>Instalación: <code><%= alerta.installationNombre || alerta.installationOrigenId %></code></span>
                      <span>Alcance: <code><%= etiquetaAlcanceRemoto(alerta.scope.nivel) %></code></span>
                      <span>Última confirmación: <code><time data-fecha-utc="<%= alerta.frescura.ultimaConfirmacionUtc %>"><%= alerta.frescura.ultimaConfirmacionUtc %></time></code></span>
                    </div>
                    <div class="dropdown dashboard-alerta-remota__acciones">
                      <button type="button" class="btn btn-outline-secondary btn-sm tabla-acciones__toggle"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        aria-label="Acciones de la alerta remota con información caducada de <%= alerta.monitorNombre || 'Monitor remoto' %>">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                      </button>
                      <div class="dropdown-menu dropdown-menu-end tabla-acciones__menu">
                        <a href="<%= urlMonitorRemotoDashboard(alerta) %>" class="dropdown-item d-flex align-items-center gap-2">
                          <i class="bi bi-eye" aria-hidden="true"></i><span>Ver monitor</span>
                        </a>
                      </div>
                    </div>
                  </article>
                <% } %>
              </div>
            </details>
          <% } %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Accesos rápidos ocultos temporalmente para mantener el dashboard centrado en alertas.
  <section class="seccion-panel">
    <div class="seccion-cabecera">
      <div>
        <h2 class="d-inline-flex align-items-center gap-2"><i class="bi bi-grid-1x2" aria-hidden="true"></i><span>Accesos rápidos</span></h2>
        <p class="texto-apoyo">Puntos de entrada habituales dentro del alcance y permisos actuales.</p>
      </div>
