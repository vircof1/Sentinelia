          <span class="etiqueta">Ajustes</span>
          <strong>Configuración</strong>
          <span>Parámetros vivos del portal y estado de servicios base.</span>
        </a>
      <% } %>
    </div>
  </section>
  -->

  <!-- Alcance del usuario oculto temporalmente para mantener el dashboard centrado en alertas.
  <section class="seccion-panel">
    <div class="seccion-cabecera">
      <div>
        <h2 class="d-inline-flex align-items-center gap-2"><i class="bi bi-person-badge" aria-hidden="true"></i><span>Tu alcance</span></h2>
