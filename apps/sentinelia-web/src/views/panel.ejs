<div class="modal fade" id="modal-descarte-alerta" tabindex="-1" aria-hidden="true" data-dashboard-descarte-modal>
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" data-dashboard-descarte-form>
      <div class="modal-header">
        <div>
          <h2 class="modal-title fs-5" data-dashboard-descarte-titulo>Inhibir alerta</h2>
          <p class="texto-apoyo mb-0" data-dashboard-descarte-monitor>La alerta seguirá activa y registrando actividad.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="monitorId" data-dashboard-descarte-monitor-id>
        <input type="hidden" name="tipoAlerta" value="local" data-dashboard-descarte-tipo>
        <input type="hidden" name="proyeccionId" data-dashboard-descarte-proyeccion-id>
        <input type="hidden" name="alertaAuditoriaId" data-dashboard-descarte-alerta-id>
        <div class="mb-3">
          <label class="form-label" for="motivo-descarte-alerta">Motivo de la inhibición</label>
          <textarea
            class="form-control"
            id="motivo-descarte-alerta"
            name="motivo"
            rows="5"
            maxlength="512"
            required
            data-dashboard-descarte-motivo
            placeholder="Ejemplo: el proveedor ya está avisado y se revisará mañana."
          ></textarea>
          <div class="form-text">Máximo 512 caracteres. Debe explicar por qué deja de verse en el foco principal.</div>
        </div>
        <div>
          <label class="form-label" for="hasta-descarte-alerta">Reactivar automáticamente el</label>
          <input
            class="form-control"
            id="hasta-descarte-alerta"
            type="datetime-local"
            name="hastaUtc"
            data-dashboard-descarte-hasta
          >
          <div class="form-text">Déjalo vacío para una inhibición indefinida. Si el monitor se recupera, la inhibición finaliza igualmente.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-warning" data-dashboard-descarte-enviar>Inhibir alerta</button>
      </div>
    </form>
  </div>
</div>

