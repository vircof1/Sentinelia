<%- include('../parciales/cabecera', { titulo, usuarioActual }) %>

<section class="panel-general perfil-usuario email-confirmacion">
  <section class="card border-0 shadow-sm">
    <div class="card-body p-4 p-lg-5">
      <% if (errorConfirmacion) { %>
        <h1>Verificar correo electrónico</h1>
        <div class="alert alert-danger mt-4" role="alert">
          <strong>No se puede completar la verificación.</strong>
          <p class="mb-0"><%= errorConfirmacion.mensaje %></p>
        </div>
        <a class="btn btn-outline-secondary mt-3" href="<%= usuarioActual ? '/mi-perfil' : '/login' %>">
          Volver
        </a>
      <% } else { %>
        <% const esValidacion = confirmacion.esValidacionEmailActual; %>
        <h1><%= esValidacion ? 'Validar correo electrónico' : 'Confirmar cambio de correo' %></h1>
        <p class="text-body-secondary">
          <%= esValidacion
            ? 'El enlace ha sido reconocido, pero el correo todavía no se ha validado.'
            : 'El enlace ha sido reconocido, pero el cambio todavía no se ha aplicado.' %>
        </p>
        <div class="card mt-4">
          <div class="card-body">
            <span class="text-uppercase small text-body-secondary"><%= esValidacion
              ? 'Correo electrónico'
              : 'Nuevo correo electrónico' %></span>
            <strong class="d-block fs-5 mt-1"><%= confirmacion.emailCandidato %></strong>
            <small class="text-body-secondary">
              La solicitud expira el
              <time data-fecha-utc="<%= confirmacion.expiraEn %>"><%= confirmacion.expiraEn %></time>.
            </small>
          </div>
        </div>
        <div id="resultado-confirmacion-email" class="mt-3" aria-live="polite"></div>
        <div class="d-flex flex-wrap gap-2 mt-4">
          <button id="confirmar-email-perfil" class="btn btn-primary" type="button"
                  data-expira-en="<%= confirmacion.expiraEn %>"
                  data-etiqueta-accion="<%= esValidacion
                    ? 'Validar correo'
                    : 'Confirmar cambio' %>"
                  data-mensaje-progreso="<%= esValidacion
                    ? 'Validando el correo electrónico…'
                    : 'Confirmando el cambio de correo…' %>">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span data-etiqueta-confirmacion><%= esValidacion
              ? 'Validar correo'
              : 'Confirmar cambio' %></span>
            <span class="email-confirmacion__cuenta-atras"
                  data-cuenta-atras aria-hidden="true"></span>
          </button>
          <a class="btn btn-outline-secondary" href="/mi-perfil">Volver a mi perfil</a>
        </div>
      <% } %>
    </div>
  </section>
</section>

<% if (!errorConfirmacion) { %>
  <script src="/js/email-confirmar.js?v=2026091302"></script>
<% } %>
<%- include('../parciales/pie') %>
