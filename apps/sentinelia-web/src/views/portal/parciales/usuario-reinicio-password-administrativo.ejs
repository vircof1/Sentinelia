<%
  const reinicio = reinicioPasswordAdministrativo || {};
  const canal = reinicio.canal || { via: 'no_evaluable', evaluable: false };
  const via = canal.via;
  const disponible = Boolean(reinicio.admiteAccion);
  const idUsuarioReinicio = String(usuarioObjetivo?.id || '');
  const modalId = `reinicio-password-administrativo-${idUsuarioReinicio}`;
  const ultimo = reinicio.ultimoResultado || null;
  const etiquetasEstado = {
    aplicado_manual: 'Contraseña manual aplicada',
    pendiente_envio: 'Correo pendiente de envío',
    aceptado_smtp: 'Correo aceptado por SMTP',
    error_final: 'Envío agotado con error',
    resultado_ambiguo: 'Resultado SMTP ambiguo',
    descartado: 'Salida descartada',
    detalle_retenido: 'Detalle de salida ya retirado'
  };
%>

<section
  class="card border-0 shadow-sm overflow-hidden usuario-reinicio-password"
  data-reinicio-password-administrativo
  data-via-esperada="<%= via %>"
  data-email-guardado="<%= usuarioObjetivo?.email || '' %>"
  data-url-comando="/usuarios/api/<%= idUsuarioReinicio %>/reiniciar-password"
  aria-labelledby="reinicio-password-titulo-<%= idUsuarioReinicio %>"
>
  <div class="card-header bg-white border-bottom py-3">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
      <div>
        <div class="d-inline-flex align-items-center gap-2 text-primary-emphasis fw-semibold">
          <i class="bi bi-key" aria-hidden="true"></i>
          <span id="reinicio-password-titulo-<%= idUsuarioReinicio %>">Reiniciar contraseña</span>
          <button
            type="button"
            class="btn btn-sm p-0 border-0 text-body-secondary"
            data-bs-toggle="tooltip"
            data-bs-trigger="hover focus click"
            data-bs-title="La vía disponible depende del estado autoritativo del correo del portal. Para cambiar ese estado necesitas permisos de configuración."
            aria-label="Explicar cómo se determina la vía de reinicio"
          ><i class="bi bi-info-circle" aria-hidden="true"></i></button>
        </div>
        <p class="mb-0 mt-1 text-body-secondary">
          Sustituye la credencial, cierra las sesiones vigentes y exige elegir una
          contraseña nueva en el siguiente acceso.
        </p>
      </div>
      <span class="estado-badge estado-badge--compacto <%= via === 'correo' ? 'estado-badge--activo' : via === 'manual' ? 'estado-badge--pendiente' : 'estado-badge--inactivo' %>">
        <%= via === 'correo' ? 'Vía por correo' : via === 'manual' ? 'Vía manual' : 'Vía no evaluable' %>
      </span>
    </div>
  </div>

  <div class="card-body p-4 d-grid gap-3">
    <% if (via === 'correo') { %>
      <div class="alert alert-info mb-0" role="note">
        Sentinelia generará una contraseña provisional, la enviará al email
        actualmente guardado y no la mostrará al operador.
      </div>
      <% if (reinicio.advertencias?.includes('email_no_validado')) { %>
        <div class="alert alert-warning mb-0" role="alert">
          El email guardado no está validado. Esta vía administrativa puede
          utilizarlo igualmente; confirma antes que pertenece a la persona correcta.
        </div>
      <% } %>
      <details class="usuario-reinicio-password__ayuda">
        <summary>Si el correo no llega</summary>
        <p class="mb-0 mt-2 text-body-secondary">
          Una persona con permiso sobre la configuración del portal debe reparar
          el correo o declararlo no operativo. La vía manual solo estará disponible
          después de ese cambio.
        </p>
      </details>
    <% } else if (via === 'manual') { %>
      <div class="alert alert-warning mb-0" role="note">
        El portal no puede despachar correo. Tú elegirás y conocerás la contraseña
        provisional; deberás entregarla al usuario por un canal adecuado.
      </div>
    <% } else { %>
      <div class="alert alert-danger mb-0" role="alert">
        Sentinelia no puede evaluar ahora la vía autoritativa. No se permite
        degradar a un reinicio manual: vuelve a intentarlo cuando la plataforma
        recupere su operatividad.
      </div>
    <% } %>

    <% if (ultimo) { %>
      <div class="usuario-reinicio-password__ultimo" aria-label="Último reinicio administrativo visible">
        <strong>Último resultado</strong>
        <span><%= etiquetasEstado[ultimo.estado] || 'Estado no disponible' %></span>
        <% if (ultimo.aplicadoEnUtc) { %>
          <time data-fecha-utc="<%= ultimo.aplicadoEnUtc %>"><%= ultimo.aplicadoEnUtc %></time>
        <% } %>
      </div>
    <% } %>

    <div>
      <button
        type="button"
        class="btn btn-danger"
        data-reinicio-password-abrir
        data-bs-toggle="modal"
        data-bs-target="#<%= modalId %>"
        <%= disponible ? '' : 'disabled' %>
      >
        <i class="bi bi-key-fill" aria-hidden="true"></i>
        Preparar reinicio
      </button>
    </div>
  </div>

  <div
    class="modal fade"
    id="<%= modalId %>"
    tabindex="-1"
    aria-labelledby="<%= modalId %>-titulo"
    aria-describedby="<%= modalId %>-descripcion"
    aria-hidden="true"
    data-reinicio-password-modal
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form data-reinicio-password-formulario novalidate autocomplete="off">
          <div class="modal-header">
            <h2 class="modal-title fs-5" id="<%= modalId %>-titulo">
              Confirmar reinicio de contraseña
            </h2>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Cancelar y cerrar"
            ></button>
          </div>
          <div class="modal-body d-grid gap-3">
            <p id="<%= modalId %>-descripcion" class="mb-0">
              Esta operación sustituirá inmediatamente la credencial de
              <strong><%= usuarioObjetivo?.usuario || 'este usuario' %></strong>,
              cerrará sus sesiones y forzará el cambio en el próximo acceso.
            </p>
            <% if (via === 'correo') { %>
              <div class="usuario-reinicio-password__destino">
                <span>Correo guardado al que se enviará</span>
                <strong><%= usuarioObjetivo?.email || 'Sin correo guardado' %></strong>
                <% if (reinicio.advertencias?.includes('email_no_validado')) { %>
                  <span class="text-warning-emphasis">Esta dirección no está validada.</span>
                <% } %>
              </div>
              <div class="alert alert-warning mb-0" role="alert" data-reinicio-email-sin-guardar hidden>
                Hay otro email escrito en el formulario, pero sin guardar. El reinicio usará la dirección guardada que aparece arriba.
              </div>
              <div class="alert alert-info mb-0">
                La contraseña provisional solo se incorporará al correo. No se
                mostrará aquí ni en el resultado de la operación.
              </div>
            <% } else if (via === 'manual') { %>
              <div>
                <label class="form-label" for="<%= modalId %>-password">Contraseña provisional</label>
                <input
                  class="form-control"
                  id="<%= modalId %>-password"
                  name="password"
                  type="password"
                  autocomplete="new-password"
                  required
                  data-reinicio-password-campo
                >
              </div>
              <div>
                <label class="form-label" for="<%= modalId %>-confirmacion">Confirmar contraseña</label>
                <input
                  class="form-control"
                  id="<%= modalId %>-confirmacion"
                  name="password_confirmacion"
                  type="password"
                  autocomplete="new-password"
                  required
                  data-reinicio-password-campo
                >
              </div>
            <% } %>
            <div class="alert alert-danger mb-0" data-reinicio-password-error role="alert" hidden></div>
            <div class="visually-hidden" aria-live="polite" data-reinicio-password-estado></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
              Cancelar
            </button>
            <button type="submit" class="btn btn-danger" data-reinicio-password-confirmar>
              <%= via === 'correo' ? 'Reiniciar y solicitar envío' : 'Sustituir contraseña' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
