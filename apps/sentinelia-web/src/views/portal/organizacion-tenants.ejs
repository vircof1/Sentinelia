<%- include('../parciales/cabecera', { titulo, usuarioActual }) %>

<section class="panel-general">
  <%- include('parciales/organizacion-cabecera', {
    tituloSeccion,
    descripcionSeccion,
    resumen,
    subnavegacionOrganizacion,
    flashOrganizacion,
    contextoUsuarioActual,
    tenantFiltro: null,
    empresaFiltro: null
  }) %>

  <section
    class="seccion-panel"
    data-tenants-lista
    data-url-listado="/organizacion/tenants/api/listado"
    data-eliminacion-durable="<%= capacidadesPortal?.eliminacionAdministrativaOrganizaciones ? 'true' : 'false' %>"
    data-empty-message="No hay tenants visibles con el filtro actual."
  >
    <div class="seccion-cabecera">
      <div>
        <h2>Catálogo de tenants</h2>
        <p class="texto-apoyo">
          Búsqueda viva por nombre, alias o descripción, con paginación y
          ordenación al estilo directorio administrativo.
        </p>
      </div>
      <% if (capacidades.puedeCrearTenant) { %>
        <a href="/organizacion/tenants/nuevo" class="btn btn-primary organizacion-accion-principal">
          <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
          Nuevo tenant
        </a>
      <% } %>
    </div>

    <div class="card border-0 shadow-sm organizacion-listado">
      <div class="card-body">
        <div class="row g-3 align-items-end organizacion-toolbar">
          <div class="col-12 col-lg-6">
            <label for="filtro_busqueda_tenants" class="form-label">
              Buscar tenant
            </label>
            <div class="organizacion-input-icono">
              <i class="bi bi-search" aria-hidden="true"></i>
              <input
                id="filtro_busqueda_tenants"
                type="search"
                class="form-control"
                placeholder="Nombre, alias o descripción"
                autocomplete="off"
                data-tenants-busqueda
              >
            </div>
          </div>

          <div class="col-6 col-lg-3">
            <label for="filtro_filas_tenants" class="form-label">
              Filas
            </label>
            <select
              id="filtro_filas_tenants"
              class="form-select"
              data-tenants-page-size
            >
              <% for (const tamano of [10, 25, 50, 100]) { %>
                <option value="<%= tamano %>" <%= tamano === 25 ? 'selected' : '' %>>
                  <%= tamano %>
                </option>
              <% } %>
            </select>
          </div>

          <div class="col-6 col-lg-3">
            <button
              type="button"
              class="btn btn-outline-secondary w-100"
              data-tenants-limpiar
            >
              <i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>
              Limpiar filtros
            </button>
          </div>
        </div>

        <div class="d-flex justify-content-between gap-3 flex-wrap align-items-start mt-4">
          <p class="text-body-secondary mb-0" data-tenants-resumen-listado>
            Cargando tenants...
          </p>
        </div>

        <div class="table-responsive mt-4 organizacion-tabla organizacion-tabla--tenants">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">
                  <button type="button" class="boton-orden" data-sort-by="id">
                    ID
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="boton-orden" data-sort-by="nombre">
                    Nombre
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="boton-orden" data-sort-by="alias">
                    Alias
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="boton-orden" data-sort-by="descripcion">
                    Descripción
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="boton-orden" data-sort-by="estado">
                    Estado
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="boton-orden" data-sort-by="empresas">
                    Empresas
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="boton-orden" data-sort-by="sitios">
                    Sitios
                  </button>
                </th>
                <th scope="col">
                  <button type="button" class="boton-orden" data-sort-by="actualizado">
                    Actualizado
                  </button>
                </th>
                <th scope="col" class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody data-tenants-filas>
              <tr>
                <td colspan="9" class="text-body-secondary">
                  Cargando tenants...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div
          class="d-flex justify-content-between align-items-center gap-3 flex-wrap border-top mt-4 pt-3"
          data-tenants-paginador
        >
          <span class="text-body-secondary" data-tenants-pagina-actual></span>

          <div class="btn-group" role="group" aria-label="Paginación tenants">
            <button type="button" class="btn btn-outline-secondary" data-page-action="first">
              <i class="bi bi-chevron-double-left me-2" aria-hidden="true"></i>
              Primero
            </button>
            <button type="button" class="btn btn-outline-secondary" data-page-action="prev">
              <i class="bi bi-chevron-left me-2" aria-hidden="true"></i>
              Anterior
            </button>
            <button type="button" class="btn btn-outline-secondary" data-page-action="next">
              Siguiente
              <i class="bi bi-chevron-right ms-2" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary" data-page-action="last">
              Último
              <i class="bi bi-chevron-double-right ms-2" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</section>

<%- include('parciales/organizacion-modal-eliminacion') %>
<script src="/js/organizacion-eliminacion.js"></script>
<script src="/js/organizacion-tenants.js"></script>
<%- include('../parciales/pie') %>
