<%- include('../parciales/cabecera', { titulo, usuarioActual }) %>

<%
  const detalle = diagnostico.detalle;
  const scope = (valor) => valor.sitioId
    ? `Tenant #${valor.tenantId} · Empresa #${valor.empresaId} · Sitio #${valor.sitioId}`
    : valor.empresaId
      ? `Tenant #${valor.tenantId} · Empresa #${valor.empresaId}`
      : valor.tenantId ? `Tenant #${valor.tenantId}` : 'Portal completo';
  const claseEstado = (valor) => [
    'vinculada','operativoCompleto','completa','promovida','resueltaEvidencia',
    'resueltaExclusionResincronizada'
  ].includes(valor)
    ? 'insignia-monitor--ok'
    : ['detenido','degradado','fallida','huecoIrrecuperable','abierta'].includes(valor)
      ? 'insignia-monitor--alerta'
      : 'insignia-monitor--advertencia';
%>

<section class="panel-general">
  <section class="hero-operativo hero-monitores card border-0 shadow-lg overflow-hidden">
    <div class="card-body hero-operativo__cuerpo p-4 p-lg-5">
      <div class="row g-4 align-items-start">
        <div class="col-12 col-xl-7">
          <span class="insignia-suave"><i class="bi bi-activity" aria-hidden="true"></i> Lectura técnica autorizada</span>
          <h1>Diagnóstico de federación</h1>
          <p>
            Explica el estado durable de una relación y sus flujos sin alterar
            cursores, generaciones ni decisiones de reconstrucción.
          </p>
          <div class="alert alert-info mb-0">
            Una posición terminal acredita recorrido, no completitud funcional.
            Los rangos dispersos tampoco adelantan el cursor continuo.
          </div>
        </div>
        <div class="col-12 col-xl-5">
          <div class="rejilla-resumen">
            <article class="kpi-resumen kpi-resumen--suave"><span class="etiqueta">Flujos</span><strong><%= diagnostico.resumen.flujos %></strong></article>
            <article class="kpi-resumen kpi-resumen--neutro"><span class="etiqueta">Generaciones</span><strong><%= diagnostico.resumen.generaciones %></strong></article>
            <article class="kpi-resumen kpi-resumen--alerta"><span class="etiqueta">Huecos pendientes</span><strong><%= diagnostico.resumen.huecosAbiertos %></strong></article>
            <article class="kpi-resumen kpi-resumen--alerta"><span class="etiqueta">Divergencias abiertas</span><strong><%= diagnostico.resumen.divergenciasAbiertas %></strong></article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <% if (errorSeleccion) { %>
    <div class="mensaje-error mt-4" role="alert"><strong>No se pudo abrir la relación solicitada</strong><p class="mb-0"><%= errorSeleccion %></p></div>
  <% } %>

  <% if (diagnostico.capacidadesConfiguracion) { %>
    <section class="tarjeta mt-4" data-diagnostico-capacidades-federacion>
      <div class="seccion-cabecera">
        <div>
          <span class="insignia-suave">Configuración viva</span>
          <h2>Capacidades de la instalación</h2>
          <p class="mb-0">La salida y la entrada se evalúan de forma independiente.</p>
        </div>
      </div>
      <div class="rejilla-resumen">
        <article class="kpi-resumen kpi-resumen--<%= diagnostico.capacidadesConfiguracion.activacionGlobal ? 'suave' : 'alerta' %>">
          <span class="etiqueta">Activación global</span>
          <strong><%= diagnostico.capacidadesConfiguracion.activacionGlobal ? 'Activa' : 'Desactivada' %></strong>
        </article>
        <article class="kpi-resumen kpi-resumen--<%= diagnostico.capacidadesConfiguracion.emisionDisponible ? 'suave' : 'alerta' %>">
          <span class="etiqueta">Emisión saliente</span>
          <strong><%= diagnostico.capacidadesConfiguracion.emisionDisponible ? 'Disponible' : 'Bloqueada' %></strong>
        </article>
        <article class="kpi-resumen kpi-resumen--<%= diagnostico.capacidadesConfiguracion.recepcionPreparada ? 'suave' : 'alerta' %>">
          <span class="etiqueta">Recepción pública</span>
          <strong><%= diagnostico.capacidadesConfiguracion.recepcionPreparada ? 'Preparada' : 'No preparada' %></strong>
        </article>
      </div>
      <div class="row g-3 mt-1">
        <div class="col-12 col-lg-6">
          <strong>Bloqueos de emisión</strong>
          <% if (diagnostico.capacidadesConfiguracion.bloqueos.emision.length === 0) { %>
            <p class="mb-0">Ninguno por configuración.</p>
          <% } else { %>
            <ul class="mb-0"><% for (const bloqueo of diagnostico.capacidadesConfiguracion.bloqueos.emision) { %><li><code><%= bloqueo %></code></li><% } %></ul>
          <% } %>
        </div>
        <div class="col-12 col-lg-6">
          <strong>Bloqueos de recepción</strong>
          <% if (diagnostico.capacidadesConfiguracion.bloqueos.recepcion.length === 0) { %>
            <p class="mb-0">Ninguno por configuración.</p>
          <% } else { %>
            <ul class="mb-0"><% for (const bloqueo of diagnostico.capacidadesConfiguracion.bloqueos.recepcion) { %><li><code><%= bloqueo %></code></li><% } %></ul>
          <% } %>
        </div>
      </div>
      <% if (diagnostico.capacidadesConfiguracion.emisionDisponible && !diagnostico.capacidadesConfiguracion.recepcionPreparada) { %>
        <div class="alert alert-info mt-3 mb-0">
          La emisión sigue disponible. Los bloqueos receptores no son fallos globales
          ni impiden conexiones salientes hacia destinos HTTPS aprobados.
        </div>
      <% } %>
    </section>
  <% } %>

  <section class="tarjeta mt-4">
    <div class="seccion-cabecera"><div><span class="insignia-suave">Scope efectivo</span><h2>Relación diagnosticada</h2></div></div>
    <form method="get" action="/federacion/diagnostico" class="row g-3 align-items-end">
      <div class="col-12 col-lg-10">
        <label for="relacion" class="form-label">Relación visible</label>
        <input id="relacion" name="relacion" class="form-control font-monospace"
          list="relaciones-visibles" value="<%= detalle?.relacion.relacionId || '' %>"
          placeholder="sfid1.relacion.…" maxlength="64">
        <datalist id="relaciones-visibles">
          <% for (const relacion of diagnostico.relaciones) { %>
            <option value="<%= relacion.relacionId %>"><%= relacion.nombreRemoto || relacion.installationRemotaId || 'Identidad pendiente' %> · <%= relacion.direccion %> · <%= scope(relacion.scope) %></option>
          <% } %>
        </datalist>
        <div class="form-text">Se sugieren las relaciones actualizadas más recientemente; también puedes pegar una identidad visible exacta.</div>
      </div>
      <div class="col-12 col-lg-2 d-grid"><button type="submit" class="btn btn-primary">Diagnosticar</button></div>
    </form>
  </section>

  <% if (!detalle) { %>
    <section class="tarjeta mt-4"><h2>Sin relaciones visibles</h2><p class="mb-0">No existe ninguna relación federada dentro del scope actual.</p></section>
  <% } else { %>
    <section class="tarjeta mt-4">
      <div class="d-flex flex-wrap justify-content-between gap-3">
        <div><span class="insignia-monitor <%= claseEstado(detalle.relacion.estados.ciclo) %>"><%= detalle.relacion.estados.ciclo %></span><h2 class="mt-2"><%= detalle.relacion.nombreRemoto || 'Instancia remota' %></h2><code><%= detalle.relacion.relacionId %></code></div>
        <div class="text-end"><small class="d-block text-muted">Instalación remota</small><code><%= detalle.relacion.installationRemotaId || 'Pendiente de confirmar' %></code></div>
      </div>
      <dl class="row mt-4 mb-0">
        <dt class="col-sm-3">Scope</dt><dd class="col-sm-9"><%= scope(detalle.relacion.scope) %></dd>
        <dt class="col-sm-3">Estados</dt><dd class="col-sm-9"><%= detalle.relacion.estados.autoridad %> · <%= detalle.relacion.estados.identidad %> · <%= detalle.relacion.estados.compatibilidad %></dd>
        <dt class="col-sm-3">Última comunicación</dt><dd class="col-sm-9"><time data-fecha-utc="<%= detalle.relacion.ultimaComunicacionUtc || '' %>"><%= detalle.relacion.ultimaComunicacionUtc || 'No disponible' %></time></dd>
        <dt class="col-sm-3">Último error de transporte</dt><dd class="col-sm-9"><%= detalle.relacion.ultimoErrorCodigo || 'Ninguno registrado' %> · <%= detalle.relacion.fallosConsecutivos %> fallos consecutivos</dd>
      </dl>
      <p class="texto-apoyo mb-0 mt-3">
        Ventana máxima de esta lectura: <%= detalle.limitesLectura.flujos %> flujos,
        <%= detalle.limitesLectura.generaciones %> generaciones,
        <%= detalle.limitesLectura.rangosDispersos %> rangos,
        <%= detalle.limitesLectura.huecos %> huecos,
        <%= detalle.limitesLectura.recorridos %> recorridos y
        <%= detalle.limitesLectura.divergencias %> divergencias. Alcanzar un límite
        no permite concluir que no existan hechos anteriores fuera de la ventana.
      </p>
    </section>

    <% if (diagnostico.resumen.restauracionesDetenidas > 0) { %>
      <div class="alert alert-danger mt-4" role="alert">
        <strong>Restauración incoherente detenida.</strong>
        La plataforma ha señalado el conflicto y mantiene el flujo detenido. Esta pantalla no reconstruye ni invalida datos automáticamente.
      </div>
    <% } %>

    <section class="tarjeta mt-4">
      <div class="seccion-cabecera"><div><span class="insignia-suave">Plano de datos</span><h2>Flujos</h2></div></div>
      <div class="table-responsive">
        <table class="table align-middle"><thead><tr><th>Familia</th><th>Dirección</th><th>Estado</th><th>Generación activa</th><th>Backlog</th><th>Scope</th></tr></thead><tbody>
          <% for (const flujo of detalle.flujos) { %><tr>
            <td><strong><%= flujo.familia %></strong><br><code><%= flujo.flujoId %></code></td>
            <td><%= flujo.direccion %></td><td><span class="insignia-monitor <%= claseEstado(flujo.estado) %>"><%= flujo.estado %></span></td>
            <td><code><%= flujo.generacionActivaId || 'Sin generación activa' %></code></td>
            <td><%= flujo.pendientes %> pendientes · <%= flujo.bloqueadas %> bloqueadas</td><td><%= scope(flujo.scope) %></td>
          </tr><% } %>
        </tbody></table>
      </div>
    </section>

    <section class="tarjeta mt-4">
      <div class="seccion-cabecera"><div><span class="insignia-suave">Verdades versionadas</span><h2>Generaciones y cursores</h2></div></div>
      <div class="d-grid gap-3">
        <% for (const generacion of detalle.generaciones) { %>
          <article class="border rounded p-3">
            <div class="d-flex flex-wrap justify-content-between gap-2"><div><span class="insignia-monitor <%= claseEstado(generacion.estado) %>"><%= generacion.estado %></span> <strong><%= generacion.clase %> #<%= generacion.ordinal %></strong><br><code><%= generacion.generacionId %></code></div><small>Actualizada: <time data-fecha-utc="<%= generacion.actualizadaEnUtc || '' %>"><%= generacion.actualizadaEnUtc || 'No disponible' %></time></small></div>
            <dl class="row mt-3 mb-0">
              <dt class="col-sm-3">Propietario</dt><dd class="col-sm-9"><code><%= generacion.installationPropietariaId %></code><br><small>boot: <%= generacion.bootPropietarioId %> · versión <%= generacion.versionPropietario %></small></dd>
              <dt class="col-sm-3">Frontera</dt><dd class="col-sm-9"><% if (generacion.frontera) { %>inicial <%= generacion.frontera.inicial %> · operativa <%= generacion.frontera.operativa ?? 'pendiente' %> · histórica <%= generacion.frontera.historica ?? 'pendiente' %> · <%= generacion.frontera.degradada ? 'degradada' : 'íntegra' %><% } else { %>No materializada<% } %></dd>
              <dt class="col-sm-3">Cursor receptor</dt><dd class="col-sm-9"><% if (generacion.cursorReceptor) { %>prefijo terminal <%= generacion.cursorReceptor.posicionTerminalContigua %> / frontera <%= generacion.cursorReceptor.fronteraInicial %> · versión <%= generacion.cursorReceptor.version %> · <%= generacion.cursorReceptor.rangosDispersos.length %> rangos dispersos<% } else { %>No aplicable o todavía ausente<% } %></dd>
              <dt class="col-sm-3">Cursor emisor</dt><dd class="col-sm-9"><% if (generacion.cursorEmisor) { %>local <%= generacion.cursorEmisor.posicionTerminalLocal %> · remoto <%= generacion.cursorEmisor.posicionTerminalRemota %> · versión remota <%= generacion.cursorEmisor.versionRemota %><% if (generacion.cursorEmisor.causaPausa) { %> · pausa: <%= generacion.cursorEmisor.causaPausa %><% } %><% } else { %>No aplicable o todavía ausente<% } %></dd>
              <% if (generacion.resincronizacion) { %><dt class="col-sm-3">Resincronización</dt><dd class="col-sm-9"><%= generacion.resincronizacion.estado %> por <%= generacion.resincronizacion.causa %> · predecesora <code><%= generacion.resincronizacion.generacionPredecesoraId %></code></dd><% } %>
            </dl>
            <% if (generacion.cursorReceptor?.rangosDispersos.length) { %><details class="mt-2"><summary>Rangos terminales aún no absorbidos</summary><ul class="mb-0 mt-2"><% for (const rango of generacion.cursorReceptor.rangosDispersos) { %><li><%= rango.inicio %>–<%= rango.fin %><%= rango.contieneDegradacion ? ' · contiene degradación' : '' %></li><% } %></ul></details><% } %>
          </article>
        <% } %>
      </div>
    </section>

    <section class="tarjeta mt-4">
      <div class="seccion-cabecera"><div><span class="insignia-suave">Disponibilidad declarada</span><h2>Huecos</h2></div></div>
      <% if (!detalle.huecos.length) { %><p class="mb-0">No hay huecos declarados para esta relación.</p><% } %>
      <div class="d-grid gap-2"><% for (const hueco of detalle.huecos) { %><article class="border rounded p-3 <%= hueco.restauracionDetenida ? 'border-danger' : '' %>">
        <span class="insignia-monitor <%= claseEstado(hueco.tipo) %>"><%= hueco.tipo %></span> <strong><%= hueco.familia %> · posiciones <%= hueco.inicio %>–<%= hueco.fin %></strong>
        <p class="mb-1 mt-2">Causa: <%= hueco.causa %> · rutas alternativas <%= hueco.rutasAlternativasAgotadas ? 'agotadas' : 'no agotadas' %> · cursor <%= hueco.aplicadaAlCursor ? 'actualizado' : 'pendiente' %>.</p>
        <code><%= hueco.declaracionId %></code>
      </article><% } %></div>
    </section>

    <section class="tarjeta mt-4">
      <div class="seccion-cabecera"><div><span class="insignia-suave">Procedencia causal</span><h2>Recorridos conservados</h2></div></div>
      <% if (!detalle.recorridos.length) { %><p class="mb-0">No hay contribuciones materializadas por esta relación.</p><% } %>
      <div class="d-grid gap-2"><% for (const recorrido of detalle.recorridos) { %><details class="border rounded p-3"><summary><strong><%= recorrido.familia %></strong> · <%= recorrido.longitudDeclarada %> saltos · <code><%= recorrido.contribucionId %></code></summary><ol class="mt-3 mb-2"><% for (const salto of recorrido.saltos) { %><li><code><%= salto.installationId %></code></li><% } %></ol><small><%= recorrido.estados.autoridad %> · <%= recorrido.estados.identidad %> · <%= recorrido.estados.compatibilidad %> · <%= recorrido.estados.integridad %></small></details><% } %></div>
    </section>

    <section class="tarjeta mt-4">
      <div class="seccion-cabecera"><div><span class="insignia-suave">Consistencia</span><h2>Divergencias</h2></div></div>
      <% if (!detalle.divergencias.length) { %><p class="mb-0">No hay divergencias conocidas en proyecciones aportadas por esta relación.</p><% } %>
      <div class="d-grid gap-2"><% for (const divergencia of detalle.divergencias) { %><article class="border rounded p-3"><span class="insignia-monitor <%= claseEstado(divergencia.estado) %>"><%= divergencia.estado %></span> <strong><%= divergencia.familia %> · secuencia <%= divergencia.secuenciaAmbigua %></strong><p class="mb-1 mt-2"><%= divergencia.totalVariantes %> variantes · observada <%= divergencia.vecesObservada %> veces.</p><code><%= divergencia.proyeccionId %></code><% if (divergencia.fronteraCoherente) { %><p class="mb-0 mt-2">Frontera coherente: <%= divergencia.fronteraCoherente.secuencia %> (<%= divergencia.fronteraCoherente.vigencia %>)</p><% } %></article><% } %></div>
    </section>

    <section class="tarjeta mt-4">
      <div class="seccion-cabecera"><div><span class="insignia-suave">Estados derivados</span><h2>Diagnósticos de relación</h2></div></div>
      <% if (!detalle.diagnosticos.length) { %><p class="mb-0">No hay transiciones diagnósticas registradas.</p><% } %>
      <ul class="mb-0"><% for (const estado of detalle.diagnosticos) { %><li><strong><%= estado.tipo %></strong> / <%= estado.causa %> · <%= estado.activa ? 'activa' : 'resuelta' %> · efectiva <time data-fecha-utc="<%= estado.efectivoEnUtc || '' %>"><%= estado.efectivoEnUtc || 'No disponible' %></time></li><% } %></ul>
    </section>
  <% } %>
</section>

<%- include('../parciales/pie') %>
