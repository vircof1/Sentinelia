# Plantilla para nginx instalado en el mismo host que el Compose productivo.
# Se incluye desde el contexto http. Sustituir nombre público y rutas de
# certificado antes de habilitarla.
map $http_upgrade $sentinelia_connection_upgrade {
    default upgrade;
    '' close;
}

# Los enlaces operativos contienen una capacidad efímera en el segmento. El
# proxy conserva método y ruta diagnóstica, pero nunca escribe el token.
map $request_uri $sentinelia_request_uri_log {
    default $request_uri;
    ~^/configuracion/correo/verificar/[^?]+ /configuracion/correo/verificar/[REDACTADO];
    ~^/mi-perfil/email/confirmar/[^?]+ /mi-perfil/email/confirmar/[REDACTADO];
    ~^/correo/desuscripcion/[^?]+ /correo/desuscripcion/[REDACTADO];
}

map $http_referer $sentinelia_http_referer_log {
    default $http_referer;
    ~*/configuracion/correo/verificar/[^?]+ [REDACTADO];
    ~*/mi-perfil/email/confirmar/[^?]+ [REDACTADO];
    ~*/correo/desuscripcion/[^?]+ [REDACTADO];
}

log_format sentinelia_sin_secretos '$remote_addr - $remote_user [$time_local] '
    '"$request_method $sentinelia_request_uri_log $server_protocol" $status $body_bytes_sent '
    '"$sentinelia_http_referer_log" "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name sentinelia.example;
    access_log /var/log/nginx/access.log sentinelia_sin_secretos;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sentinelia.example;

    ssl_certificate /etc/letsencrypt/live/sentinelia.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sentinelia.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log /var/log/nginx/access.log sentinelia_sin_secretos;

    # El límite de aplicación sigue siendo autoritativo. Este margen evita que
    # nginx corte el sobre HTTP antes de que Sentinelia pueda clasificarlo.
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Esta topología tiene un único salto: se reemplaza cualquier valor que
        # haya enviado el cliente en vez de incorporarlo a la cadena confiable.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sentinelia_connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 65s;
        proxy_read_timeout 65s;
    }
}
